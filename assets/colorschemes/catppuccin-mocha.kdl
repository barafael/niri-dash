// niri-dash color scheme: "catppuccin-mocha" (Catppuccin Mocha). See default.kdl for what each color is for.

colors {
    backdrop    "#11111bd9"
    card        "#1e1e2ef2"
    card-raised "#313244"
    panel       "#1e1e2e"
    hover       "#cdd6f412"
    pressed     "#cdd6f420"
    border      "#cdd6f417"
    subtle      "#cdd6f40a"
    shadow      "#00000090"
    text        "#cdd6f4"
    dim         "#a6adc8"
    faint       "#6c7086"
    accent      "#cba6f7"
    accent-soft "#cba6f733"
    on-accent   "#11111b"
    good        "#a6e3a1"
    warn        "#fab387"
    bad         "#f38ba8"
    track       "#cdd6f417"
    knob        "#cdd6f4"
}
