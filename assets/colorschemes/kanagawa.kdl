// niri-dash color scheme: "kanagawa" (Kanagawa Wave). See default.kdl for what each color is for.

colors {
    backdrop    "#16161dd9"
    card        "#1f1f28f2"
    card-raised "#272733"
    panel       "#1a1a22"
    hover       "#dcd7ba1f"
    pressed     "#dcd7ba36"
    border      "#dcd7ba1a"
    subtle      "#dcd7ba0a"
    shadow      "#00000090"
    text        "#dcd7ba"
    dim         "#a6a69c"
    faint       "#727169"
    accent      "#7e9cd8"
    accent-soft "#7e9cd833"
    on-accent   "#16161d"
    good        "#98bb6c"
    warn        "#e6c384"
    bad         "#ff5d62"
    track       "#dcd7ba1f"
    knob        "#dcd7ba"
}
