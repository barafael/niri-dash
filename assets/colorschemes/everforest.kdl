    subtle      "#d3c6aa0a"
    shadow      "#00000090"
    text        "#d3c6aa"
    dim         "#9da9a0"
    faint       "#7a8478"
    accent      "#7fbbb3"
    accent-soft "#7fbbb333"
    on-accent   "#1e2326"
    good        "#a7c080"
    warn        "#e5a96e"
    bad         "#e67e80"
    track       "#d3c6aa1f"
    knob        "#d3c6aa"
}
