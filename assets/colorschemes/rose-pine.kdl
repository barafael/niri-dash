    shadow      "#00000090"
    text        "#e0def4"
    dim         "#908caa"
    faint       "#6e6a86"
    accent      "#c4a7e7"
    accent-soft "#c4a7e733"
    on-accent   "#12101c"
    good        "#9ccfd8"
    warn        "#f6c177"
    bad         "#eb6f92"
    track       "#e0def41f"
    knob        "#e0def4"
}
