// niri-dash color scheme: "default" (dark, after Tokyo Night).
//
// A color scheme only holds colors; corners, spacing, fonts and animation speed are a style
// (see ../styles/). Copy this file to make your own and pick it in the dashboard (edit mode >
// Widgets & look > Look) or in config.kdl. Anything left out keeps the default.
// Colors are "#rrggbb" or "#rrggbbaa" (alpha last).

colors {
    backdrop    "#07090dd9"   // dims the screen behind the dashboard
    card        "#161a22f2"   // widget background
    card-raised "#1f2430"     // buttons, list cards inside widgets
    panel       "#12151c"     // drawer, menus, toasts, edit toolbars
    hover       "#ffffff18"
    pressed     "#ffffff2a"
    border      "#ffffff14"
    subtle      "#ffffff08"   // graph and grid backgrounds
    shadow      "#00000090"
    text        "#e6e9f0"
    dim         "#9aa3b5"     // secondary text
    faint       "#646c80"     // tertiary text, inactive icons
    accent      "#7aa2f7"
    accent-soft "#7aa2f733"   // selected rows, active buttons
    on-accent   "#10131a"     // text on accent fills
    good        "#9ece6a"
    warn        "#e0af68"
    bad         "#f7768e"
    track       "#ffffff14"   // slider and ring tracks
    knob        "#dfe3ec"     // slider knobs
}
