// niri-dash color scheme: "light" (light, neutral). See default.kdl for what each color is for.

colors {
    backdrop    "#e9ecf2d0"
    card        "#fffffff0"
    card-raised "#f3f5f9"
    panel       "#f7f8fb"
    hover       "#1d23301a"
    pressed     "#1d233030"
    border      "#1d233026"
    subtle      "#1d23300a"
    shadow      "#00000040"
    text        "#1d2330"
    dim         "#556070"
    faint       "#8590a0"
    accent      "#3b6fe0"
    accent-soft "#3b6fe029"
    on-accent   "#ffffff"
    good        "#2b8f3f"
    warn        "#c2701c"
    bad         "#d6336c"
    track       "#1d233026"
    knob        "#556070"
}
