##
## A sheep, drawn for niri-dash (MIT OR Apache-2.0), used when cowsay has no cow of this name.
##
$the_cow = <<EOC;
        $thoughts       .-~~-~~-~~-.
         $thoughts    .(  ~   ~   ~ ).
          $thoughts  ($eyes)~   ~   ~  ~ )
             ($tongue)'~-~~-~~-~~-'
                  ||      ||
EOC
