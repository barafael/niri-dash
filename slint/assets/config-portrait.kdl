// The default on a screen taller than wide: fewer widgets, stacked.
theme colorscheme="default" style="default"

layout {
    clock           col=0 row=0  width=3 height=2
    weather         col=3 row=0  width=3 height=2
    notifications   col=0 row=2  width=3 height=4
    windows         col=3 row=2  width=3 height=4
    media           col=0 row=6  width=6 height=2
    wifi            col=0 row=8  width=3 height=3
    bluetooth       col=3 row=8  width=3 height=3
    volume          col=0 row=11 size=2 shape="round"
    brightness      col=2 row=11 size=2 shape="round"
    battery         col=4 row=11 width=2 height=2
    session         col=0 row=13 width=6 height=1
}
