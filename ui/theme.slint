import { WeatherIcon } from "data.slint";

// Rust sets these from the chosen color scheme and style (~/.config/niri-dash/colorschemes/*.kdl
// and styles/*.kdl) and the user's adjustments.
export global Theme {
    in-out property <color> backdrop: #07090dd9;
    in-out property <color> card: #161a22f2;
    in-out property <color> card-raised: #1f2430;
    in-out property <color> panel: #12151c;
    in-out property <color> hover: #ffffff12;
    in-out property <color> pressed: #ffffff20;
    in-out property <color> border: #ffffff14;
    in-out property <color> subtle: #ffffff08;
    in-out property <color> shadow: #00000090;
    in-out property <color> text: #e6e9f0;
    in-out property <color> dim: #9aa3b5;
    in-out property <color> faint: #5b6375;
    in-out property <color> accent: #7aa2f7;
    in-out property <color> accent-soft: #7aa2f733;
    in-out property <color> on-accent: #10131a;
    in-out property <color> good: #9ece6a;
    in-out property <color> warn: #e0af68;
    in-out property <color> bad: #f7768e;
    in-out property <color> track: #ffffff14;
    in-out property <color> knob: #dfe3ec;
    in-out property <length> radius: 20px;
    in-out property <length> radius-small: 12px;
    in-out property <length> gap: 7px;
    in-out property <length> pad: 16px;
    // For widgets whose content wants the room, and for cards inside a widget.
    out property <length> pad-tight: max(6px, self.pad * 0.6);
    in-out property <length> font-small: 12px;
    in-out property <length> font-body: 14px;
    in-out property <length> font-title: 15px;
    in-out property <string> font-family;
    in-out property <int> font-weight-display: 300;
    // Animation speed: 1 = normal, 0.5 = twice as fast, 0 = no animations.
    in-out property <float> motion: 1;
    in-out property <float> border-width: 1;
    // Frosted glass: the compositor blurs what's behind the dashboard.
    in-out property <bool> glass;
    // Multipliers for the backdrop's and widgets' opacity (0..1).
    in-out property <float> backdrop-opacity: 1;
    in-out property <float> card-opacity: 1;
}

export global Icons {
    public pure function weather(icon: WeatherIcon) -> image {
        if (icon == WeatherIcon.sun) { return self.sun; }
        if (icon == WeatherIcon.moon) { return self.moon; }
        if (icon == WeatherIcon.cloud-sun) { return self.cloud-sun; }
        if (icon == WeatherIcon.cloud-moon) { return self.cloud-moon; }
        if (icon == WeatherIcon.fog) { return self.fog; }
        if (icon == WeatherIcon.rain) { return self.rain; }
        if (icon == WeatherIcon.snow) { return self.snow; }
        if (icon == WeatherIcon.storm) { return self.storm; }
        return self.cloud;
    }

    out property <image> wifi: @image-url("icons/wifi.svg");
    out property <image> wifi-off: @image-url("icons/wifi-off.svg");
    out property <image> bluetooth: @image-url("icons/bluetooth.svg");
    out property <image> battery: @image-url("icons/battery.svg");
    out property <image> bolt: @image-url("icons/bolt.svg");
    out property <image> volume: @image-url("icons/volume.svg");
    out property <image> volume-mute: @image-url("icons/volume-mute.svg");
    out property <image> mic: @image-url("icons/mic.svg");
    out property <image> mic-off: @image-url("icons/mic-off.svg");
    out property <image> sun: @image-url("icons/sun.svg");
    out property <image> bell: @image-url("icons/bell.svg");
    out property <image> bell-off: @image-url("icons/bell-off.svg");
    out property <image> power: @image-url("icons/power.svg");
    out property <image> lock: @image-url("icons/lock.svg");
    out property <image> moon: @image-url("icons/moon.svg");
    out property <image> coffee: @image-url("icons/coffee.svg");
    out property <image> logout: @image-url("icons/logout.svg");
    out property <image> restart: @image-url("icons/restart.svg");
    out property <image> play: @image-url("icons/play.svg");
    out property <image> pause: @image-url("icons/pause.svg");
    out property <image> next: @image-url("icons/next.svg");
    out property <image> prev: @image-url("icons/prev.svg");
    out property <image> close: @image-url("icons/close.svg");
    out property <image> plus: @image-url("icons/plus.svg");
    out property <image> minus: @image-url("icons/minus.svg");
    out property <image> edit: @image-url("icons/edit.svg");
    out property <image> circle: @image-url("icons/circle.svg");
    out property <image> square: @image-url("icons/square.svg");
    out property <image> settings: @image-url("icons/settings.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> chevron-left: @image-url("icons/chevron-left.svg");
    out property <image> chevron-right: @image-url("icons/chevron-right.svg");
    out property <image> check: @image-url("icons/check.svg");
