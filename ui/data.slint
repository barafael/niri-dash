// Data the Rust side pushes into the UI, one global per source, plus the callbacks widgets use to
// act on it. Several widget instances of the same kind share one global.

export enum WidgetKind { clock, calendar, system-monitor, windows, claude-sessions, wifi, bluetooth, battery, volume, brightness, notifications, tray, media, session, clipboard, weather, memory, disks, network, gpu, claude-usage, mascot, keyboard-layout, color-picker, timer, stopwatch, notes, privacy, night-light, removable-drives, phone, sleep-timer }
export enum Shape { rect, round }

// The sidebar's sections.
export enum DrawerTab { widgets, colors, style, widget }
// The pointer shape the platform layer should show.
export enum PointerShape { normal, move, resize-ew, resize-ns, resize-nwse, resize-nesw }
// The mascots (src/mascots.rs) and what they wear for a line.
export enum Character { schraubi, zolli, verschnitti, cow }
export enum Outfit { plain, helmet, vest, beard, shades, tophat, party }

// Per-widget settings (Rust fills in every field, defaults included). Each widget reads the ones
// that apply to it.
export struct WidgetOpts {
    // Clock.
    hours12: bool,
    seconds: bool,
    date: bool,
    // Calendar.
    sunday-first: bool,
    week-numbers: bool,
    // Charts: how many one-second samples to show.
    history: int,
    cores: bool,
    top-apps: int,
    hide-system: bool,
    // Session buttons.
    lock: bool,
    suspend: bool,
    logout: bool,
    restart: bool,
    poweroff: bool,
    confirm: bool,
    // Mascot.
    character: Character,
    cowfile: string,
}

export struct WidgetInst {
    id: int,
    kind: WidgetKind,
    // Its name as the palette shows it ("Wi-Fi"), for screen readers.
    title: string,
    shape: Shape,
    col: int,
    row: int,
    w: int,
    h: int,
    // The smallest it can be resized to.
    min-w: int,
    min-h: int,
    // Whether this kind of widget has a round version.
    can-round: bool,
    has-settings: bool,
    opts: WidgetOpts,
    // Its label for keyboard navigation (`f`), and that split into the first letter and the rest.
    // Its label for keyboard navigation (the start of its name).
    hint: string,
}

export struct PaletteItem {
    kind: WidgetKind,
    title: string,
    description: string,
    // Default size in cells.
    w: int,
    h: int,
}

// A hint label, letter by letter (so the part typed can be drawn dimmed).
export struct HintChars {
    chars: [string],
}

// Keyboard navigation. `f` shows a label on every widget (hints); typing one enters that widget
// (widget), whose controls j/k/h/l/Enter then work.
export enum NavMode { off, hints, widget }
export global Nav {
    in-out property <NavMode> mode;
    // The widget entered (0 = none).
    in-out property <int> active-id;
    // The widget blown up in the middle of the dashboard with `e` (0 = none); only while entered.
    in-out property <int> expanded-id;
    // Ctrl+R: the entered widget's size changes with h/j/k/l (smaller) and H/J/K/L (bigger).
    in-out property <bool> sizing;
    // Each widget's label (in the order of the dashboard's widgets), letter by letter.
    in property <[HintChars]> hint-chars;
    // The part of a two-letter label typed so far.
    in-out property <string> typed;
    // Bumped whenever the entered widget should take the keyboard.
    in-out property <int> tick;
    // The widget whose label is the text: its id, 0 while it is still the start of a label, -1
    // when it matches none.
    callback pick(string) -> int;
    // The widget next to one, in a direction (0..3 = h, j, k, l); 0 if there is none.
    callback neighbor(int, int) -> int;
}

// Called by widgets that act on something outside the dashboard (focus a window, open a tray
// app) so the overlay gets out of the way.
export global Shell {
    callback hide();
}

// The compositor we run under: niri, KDE Plasma (KWin), or another. Widgets that need one of them
// say so.
export global Desktop {
    in property <bool> niri: true;
    in property <bool> plasma;
}

export struct ZoneTime {
    label: string,
    time: string,
    delta: string,
}

export struct ZoneList {
    items: [ZoneTime],
}

export global Clock {
    // Each clock widget's other time zones, by widget id.
    in property <[ZoneList]> zones;
    in property <string> time: "00:00";
    // 12-hour form: "9:41" and "AM"/"PM".
    in property <string> time12: "12:00";
    in property <string> ampm;
    in property <string> seconds: "00";
    in property <string> date;
    in property <string> weekday;
    in property <string> month;
    in property <int> day: 1;
    in property <float> hour;
    in property <float> minute;
    in property <float> second;
}

export struct CalDay {
    day: int,
    in-month: bool,
    today: bool,
    // Under the keyboard cursor (shown while the calendar is entered).
    selected: bool,
}

export global Calendar {
    in property <string> title;
    in property <[string]> weekdays: ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"];
    in property <[CalDay]> days;
    // Week number of each row.
    in property <[int]> weeks;
    // The same, for weeks starting on Sunday.
    in property <[string]> weekdays-sun: ["So", "Mo", "Di", "Mi", "Do", "Fr", "Sa"];
    in property <[CalDay]> days-sun;
    in property <[int]> weeks-sun;
    in property <bool> showing-current: true;
    // Show the month d months on (0: back to this one). The keyboard cursor goes along.
    callback shift(int);
    // Move the keyboard cursor by d days, turning the month as it leaves the one shown.
    callback move-day(int);
}

export struct NameValue {
    name: string,
    value: string,
}

export struct DiskRow {
    mount: string,
    used: float,
    text: string,
}

export global Perf {
    in property <float> cpu;
    in property <float> mem;
    in property <[float]> cpu-history;
    in property <[float]> mem-history;
    in property <string> cpu-text;
    in property <string> mem-text;
    in property <string> temp-text;
    in property <string> net-text;
    in property <string> load-text;
    in property <[float]> cores;
    // Memory widget.
    in property <string> mem-used-text;
    in property <string> mem-avail-text;
    in property <float> swap;
    in property <string> swap-text;
    in property <[NameValue]> top-mem;
    // Network widget (both histories on one scale).
    in property <[float]> net-rx-history;
    in property <[float]> net-tx-history;
    in property <string> net-rx-text;
    in property <string> net-tx-text;
    in property <string> net-peak-text;
    in property <string> net-iface;
    in property <string> net-addr;
    in property <float> net-rx-frac;
    in property <float> net-tx-frac;
    // Disks widget.
    in property <[DiskRow]> disks;
    // `disks` without boot and firmware partitions.
    in property <[DiskRow]> user-disks;
    in property <[float]> disk-history;
    in property <string> disk-read-text;
    in property <string> disk-write-text;
    in property <float> root-used;
    // GPU widget.
    in property <bool> has-gpu;
    in property <string> gpu-name;
    in property <float> gpu-busy;
    in property <[float]> gpu-history;
    in property <float> gpu-vram;
    in property <string> gpu-vram-text;
    in property <string> gpu-temp-text;
    in property <string> gpu-power-text;
}

export struct ModelShare {
    name: string,
    share: float,
}

export global ClaudeUsage {
    in property <string> plan;
    in property <bool> window-active;
    in property <string> window-tokens;
    in property <string> window-count;
    in property <string> window-cached;
    in property <int> window-messages;
    in property <string> window-left;
    in property <float> window-progress;
    in property <string> window-resets;
    in property <string> burn;
    in property <string> today;
    in property <string> week;
    in property <[float]> hourly;
    in property <[ModelShare]> models;
}

export struct WinItem {
    id: int,
    header: bool,
    title: string,
    app: string,
    icon: image,
    has-icon: bool,
    focused: bool,
    urgent: bool,
}

export global Windows {
    in property <[WinItem]> items;
    in property <int> count;
    in property <image> focused-icon;
    in property <bool> has-focused-icon;
    in property <bool> available: true;
    callback focus(int);
    callback close(int);
}

export struct WifiNet {
    // SSID and how it is joined: networks sharing an SSID but not that are separate rows.
    key: string,
    ssid: string,
    signal: int,
    secure: bool,
    active: bool,
    known: bool,
    // How it is joined, when another row has the same SSID (an evil twin, say); else "".
    tag: string,
}

export struct WifiSaved {
    key: string,
    uuid: string,
    ssid: string,
    in-range: bool,
    // In range, or when it was last used.
    detail: string,
}

// One line of a network's details page.
export struct WifiFact {
    label: string,
    value: string,
}

// The network the details page shows.
export struct WifiDetail {
    key: string,
    ssid: string,
    in-range: bool,
    active: bool,
    known: bool,
    uuid: string,
    autoconnect: bool,
    facts: [WifiFact],
}

// The password prompt; no prompt while `ssid` is empty.
export struct WifiPrompt {
    // A new prompt (not just a new message) has a new serial; its fields start empty.
    serial: int,
    ssid: string,
    // 0: a password, 1: a WEP key, 2: a user name and password (Enterprise).
    kind: int,
    // The last password didn't work.
    retry: bool,
    // A network not saved yet: an Enterprise one can choose its method.
    new: bool,
    identity: string,
    // Why it asks again, e.g. a password too short.
    message: string,
}

export global Wifi {
    in property <bool> available;
    in property <bool> enabled;
    // Off through a hardware switch or rfkill.
    in property <bool> blocked;
    in property <string> ssid;
    in property <int> signal;
    // The key of the network being joined right now.
    in property <string> connecting;
    in property <[WifiNet]> networks;
    in property <[WifiSaved]> saved;
    in property <string> status;
    in property <bool> failed;
    in property <bool> scanning;
    // The network wants a login in the browser first.
    in property <bool> portal;
    in property <WifiPrompt> prompt;
    in property <WifiDetail> detail;
    // A saved network's password and QR code, while shown.
    in property <bool> revealed;
    in property <string> password;
    in property <image> qr;
    callback toggle();
    callback rescan();
    callback connect(string);
    // The answer to prompt `serial`: user name, password, method (0 PEAP, 1 TTLS), and for a
    // new Enterprise network the server's domain, or true to skip checking the server.
    callback answer(int, string, string, int, string, bool);
    callback cancel-prompt();
    // A hidden network: name, security (0 open, 1 WPA, 2 Enterprise), user name, password,
    // method, server domain, skip the server check.
    callback join-hidden(string, int, string, string, int, string, bool);
    callback disconnect();
    callback forget(string);
    callback set-autoconnect(string, bool);
    // Show the details of the network with this key ("" for none).
    callback select(string);
    callback reveal(string);
    callback hide-secret();
    callback sign-in();
}

export enum DeviceKind { mouse, keyboard, headphones, gamepad, phone, other }

export struct BtDevice {
    address: string,
    name: string,
    kind: DeviceKind,
    connected: bool,
    // Connected without being paired: its name is only what it claims.
    paired: bool,
    // Allowed to connect without asking.
    trusted: bool,
    // Its connections are refused.
    blocked: bool,
    battery: int,
    // Signal as 0-4 bars while a scan sees it; -1 otherwise.
    signal: int,
    busy: bool,
}

// One line of a device's details page.
export struct BtFact {
    label: string,
    value: string,
}

// The device the details page shows; none while `address` is empty.
export struct BtDetail {
    address: string,
    name: string,
    kind: DeviceKind,
    connected: bool,
    paired: bool,
    trusted: bool,
    blocked: bool,
    facts: [BtFact],
}

// A pairing prompt; none while `address` is empty.
export struct BtPrompt {
    // A new prompt has a new serial: an answer to an earlier one goes nowhere.
    serial: int,
    name: string,
    address: string,
    // 1: do the codes match, 2: enter the PIN, 3: enter the passkey, 4: type this PIN on the
    // device, 5: type this passkey on the device, 6: allow pairing.
    kind: int,
    // The code to compare or type on the device.
    code: string,
    // For 5: how many digits have been typed on the device.
    entered: int,
}

export global Bluetooth {
    in property <bool> available;
    in property <bool> powered;
    // Off through rfkill (airplane mode or a hardware switch).
    in property <bool> blocked;
    in property <string> adapter-name;
    // Looking for devices to pair.
    in property <bool> discovering;
    // Paired devices, and connected ones.
    in property <[BtDevice]> devices;
    // Unpaired devices a scan found, strongest first.
    in property <[BtDevice]> nearby;
    // How many devices without a name the scan sees.
    in property <int> unnamed;
    in property <int> connected-count;
    in property <string> status;
    in property <bool> failed;
    in property <BtPrompt> prompt;
    in property <BtDetail> detail;
    callback toggle();
    // Start or stop looking for devices.
    callback scan(bool);
    callback connect(string);
    callback disconnect(string);
    callback pair(string);
    callback cancel-pairing();
    // The answer to prompt `serial`: yes or no, and the code typed (if it asked for one).
    callback answer(int, bool, string);
    // Show a device's details ("" for none).
    callback select(string);
    callback set-trusted(string, bool);
    callback set-blocked(string, bool);
    callback forget(string);
    callback rename(string, string);
}

export enum PowerProfile { power-saver, balanced, performance }


// A battery of a mouse, keyboard, headset and so on.
export struct Peripheral {
    kind: DeviceKind,
    name: string,
    percent: int,
}

// Something blocking sleep, from logind.
export struct Blocker {
    who: string,
    why: string,
}

export global Power {
    in property <[Peripheral]> peripherals;
    in property <[Blocker]> blockers;
    in property <bool> has-battery;
    in property <int> percent;
    in property <bool> charging;
    in property <string> status-text;
    in property <PowerProfile> profile;
    in property <bool> has-profile;
    in property <[PowerProfile]> profiles;
    in property <string> power-text;
    // Blocking sleep and screen locking by hand.
    in property <bool> inhibited;
    callback set-profile(PowerProfile);
    callback toggle-inhibit();
}

export struct AudioSink {
    id: int,
    name: string,
    default: bool,
}

// An app playing sound.
export struct AudioStream {
    id: int,
    app: string,
    icon: image,
    has-icon: bool,
    volume: float,
    muted: bool,
}

export global Audio {
    in property <[AudioSink]> sinks;
    in property <[AudioStream]> streams;
    callback set-stream-volume(int, float);
    callback toggle-stream-mute(int);
    callback set-default-sink(int);
    in-out property <float> volume;
    in property <bool> muted;
    in-out property <float> mic-volume;
    in property <bool> mic-muted;
    in property <string> sink-name;
    callback set-volume(float);
    callback toggle-mute();
    callback set-mic-volume(float);
    callback toggle-mic-mute();
}

export global Brightness {
    in property <bool> available;
    in-out property <float> level;
    callback set(float);
}

// Night light: warmer screen colors. `warmth` is the slider (0 = neutral 6500 K, 1 = 2500 K).
export global NightLight {
    in property <bool> available;
    // The compositor runs night light itself (KWin): only on and off, no temperature control.
    in property <bool> fixed;
    // Replaces the temperature next to the switch, e.g. "Day" (empty: the temperature or "Off").
    in property <string> status;
    // A line under the switch, e.g. that System Settings has night light turned off.
    in property <string> note;
    in property <bool> on;
    in property <int> kelvin: 4500;
    in-out property <float> warmth;
    callback toggle();
    callback set-warmth(float);
    callback set-kelvin(int);
}

export struct Notif {
    id: int,
    app: string,
    summary: string,
    body: string,
    time: string,
    icon: image,
    has-icon: bool,
    has-default: bool,
    urgent: bool,
}

export global Notifications {
    in property <[Notif]> items;
    in property <bool> server;
    // Another server shows the notifications, and do not disturb pauses its pop-ups (Plasma).
    in property <bool> can-pause;
    // Do not disturb: on, what it says ("Paused until 7:00"), and how many came in meanwhile.
    in property <bool> dnd;
    in property <string> dnd-text;
    in property <int> missed;
    // The time "until tomorrow" ends, e.g. "7:00".
    in property <string> morning: "7:00";
    // 0 off, 1 for an hour, 2 until tomorrow morning, 3 until turned off.
    callback set-dnd(int);
    callback dismiss(int);
    callback clear();
    callback invoke(int);
}

export struct TrayItem {
    id: string,
    title: string,
    icon: image,
    has-icon: bool,
    has-menu: bool,
}

export enum MenuToggle { none, check, radio }

export struct MenuEntry {
    id: int,
    label: string,
    depth: int,
    separator: bool,
    enabled: bool,
    toggle: MenuToggle,
    checked: bool,
    header: bool,
}

export global Tray {
    in property <[TrayItem]> items;
    // The open context menu, shown as an overlay at (menu-x, menu-y) in window coordinates.
    in property <bool> menu-open;
    in property <string> menu-title;
    in property <[MenuEntry]> menu;
    in property <length> menu-x;
    in property <length> menu-y;
    // The entry under the keyboard cursor of a menu opened from the keyboard; -1: none.
    in-out property <int> menu-cursor: -1;
    callback activate(string, length, length);
    callback open-menu(string, length, length);
    callback menu-activate(int);
    callback menu-close();
}

