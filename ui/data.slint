// What a mascot says. One entry per widget id (`lines[id]`); ids without a mascot are empty.
export struct MascotLine {
    text: string,
    outfit: Outfit,
    // Changes with every new line, so the mascot can duck and pop up again.
    seq: int,
    // Lines sent with `niri-dash say` still waiting after this one.
    queued: int,
}

// A cow's drawing, in columns and lines.
export struct CowSize {
    width: int,
    lines: int,
}

export global Mascots {
    in property <[MascotLine]> lines;
    // The dashboard is up: blink and look around only then.
    in property <bool> awake;
    // Clicked: the next line (and the sent one goes away).
    callback next(int);
    // A line in the cow's ASCII speech bubble, for so many columns and lines of text.
    pure callback cow-bubble(string, int, int) -> string;
    // The drawing of the cow a `cowfile` setting names, with these eyes and tongue, and its size.
    pure callback cow-art(string, string, string) -> string;
    pure callback cow-size(string) -> CowSize;
    // The font family cows are drawn in.
    pure callback cow-font() -> string;
}

export struct LayoutItem {
    name: string,
    // The indicator text, e.g. "EN".
    short: string,
}

export global KeyboardLayouts {
    in property <bool> available;
    in property <[LayoutItem]> layouts;
    in property <int> current;
    callback next();
    callback prev();
    callback pick(int);
}

export struct PickedColor {
    color: color,
    hex: string,
    rgb: string,
    hsl: string,
}

export global ColorPicker {
    // Newest first.
    in property <[PickedColor]> colors;
    callback pick();
    callback copy(string);
}

// The timer and stopwatch widgets (shared by all of them).
export global Countdown {
    in property <string> text: "5:00";
    // Still to go: 1 at the start, 0 at the end.
    in property <float> fraction: 1;
    in property <bool> running;
    in property <bool> paused;
    // Just went off.
    in property <bool> done;
    callback toggle();
    callback reset();
    callback preset(int);
    callback adjust(int);
    in property <string> sw-text: "0:00.0";
    // How far the second hand is round: the part of the current minute gone by.
    in property <float> sw-fraction;
    in property <bool> sw-running;
    // Started at all (running or paused with time on it).
    in property <bool> sw-started;
    in property <[string]> laps;
    callback sw-toggle();
    callback sw-lap();
    callback sw-reset();
}

// Sticky notes: each notes widget's text, by widget id.
export global Notes {
    in property <[string]> texts;
    in property <[string]> names;
    callback edited(int, string);
}

export enum PrivacyKind { mic, camera, screen }

export struct PrivacyItem {
    kind: PrivacyKind,
    app: string,
    // What is shared, for screen sharing.
    detail: string,
    // niri's session id, to stop a screen share.
    session: int,
}

export global Privacy {
    in property <bool> mic;
    in property <bool> camera;
    in property <bool> screen;
    in property <[PrivacyItem]> items;
    callback stop(int);
}

// USB drives and SD cards (UDisks).
export struct DriveVolume {
    path: string,
    name: string,
    detail: string,
    mount: string,
    mounted: bool,
    locked: bool,
    // Its place among all drives' volumes (`Drives.volumes`), and its drive's path.
    index: int,
    drive: string,
}

export struct RemovableDrive {
    path: string,
    name: string,
    detail: string,
    volumes: [DriveVolume],
}

export global Drives {
    in property <bool> available;
    in property <[RemovableDrive]> drives;
    // Every drive's volumes in one list, in order (for the keyboard cursor).
    in property <[DriveVolume]> volumes;
    callback mount(string);
    callback unmount(string);
    callback eject(string);
    callback eject-all();
    callback open(string);
}

// Phones paired through KDE Connect. `charge` is -1 when unknown.
export struct PhoneItem {
    id: string,
    name: string,
    status: string,
    reachable: bool,
    charge: int,
    charging: bool,
    can-ring: bool,
    can-share: bool,
}

export global Phones {
    in property <bool> available;
    in property <[PhoneItem]> phones;
    callback ring(string);
    callback send(string);
}
