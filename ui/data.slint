// Data the Rust side pushes into the UI, one global per source, plus the callbacks widgets use to
// act on it. Several widget instances of the same kind share one global.

export enum WidgetKind { clock, calendar, perf, windows, claude, wifi, bluetooth, battery, audio, brightness, notifications, tray, media, session, clipboard, weather, memory, disks, network, gpu, claude-usage, mascot, keyboard-layout, color-picker, timer, notes, privacy }
export enum Shape { rect, round }

// The sidebar's sections.
export enum DrawerTab { widgets, colors, style, widget }
// The pointer shape the platform layer should show.
export enum PointerShape { normal, move, resize }
// The mascots (src/mascots.rs) and what they wear for a line.
export enum Character { schraubi, zolli, verschnitti }
export enum Outfit { plain, helmet, vest, beard, shades, tophat, party }

// Per-widget settings (Rust fills in every field, defaults included). Each widget reads the ones
// that apply to it.
export struct WidgetOpts {
    // Clock.
    hours12: bool,
    seconds: bool,
    date: bool,
    // Calendar.
    sunday-first: bool,
    week-numbers: bool,
    // Charts: how many one-second samples to show.
    history: int,
    cores: bool,
    top-apps: int,
    hide-system: bool,
    // Session buttons.
    lock: bool,
    suspend: bool,
    logout: bool,
    restart: bool,
    poweroff: bool,
    confirm: bool,
    // Mascot.
    character: Character,
    // Timer widget: a stopwatch instead.
    stopwatch: bool,
}

export struct WidgetInst {
    id: int,
    kind: WidgetKind,
    shape: Shape,
    col: int,
    row: int,
    w: int,
    h: int,
    // Whether this kind of widget has a round version.
    can-round: bool,
    has-settings: bool,
    opts: WidgetOpts,
}

export struct PaletteItem {
    kind: WidgetKind,
    title: string,
    description: string,
    // Default size in cells.
    w: int,
    h: int,
}

// Called by widgets that act on something outside the dashboard (focus a window, open a tray
// app) so the overlay gets out of the way.
export global Shell {
    callback hide();
}

export struct ZoneTime {
    label: string,
    time: string,
    delta: string,
}

export struct ZoneList {
    items: [ZoneTime],
}

export global Clock {
    // Each clock widget's other time zones, by widget id.
    in property <[ZoneList]> zones;
    in property <string> time: "00:00";
    // 12-hour form: "9:41" and "AM"/"PM".
    in property <string> time12: "12:00";
    in property <string> ampm;
    in property <string> seconds: "00";
    in property <string> date;
    in property <string> weekday;
    in property <string> month;
    in property <int> day: 1;
    in property <float> hour;
    in property <float> minute;
    in property <float> second;
}

export struct CalDay {
    day: int,
    in-month: bool,
    today: bool,
}

export global Calendar {
    in property <string> title;
    in property <[string]> weekdays: ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"];
    in property <[CalDay]> days;
    // Week number of each row.
    in property <[int]> weeks;
    // The same, for weeks starting on Sunday.
    in property <[string]> weekdays-sun: ["So", "Mo", "Di", "Mi", "Do", "Fr", "Sa"];
    in property <[CalDay]> days-sun;
    in property <[int]> weeks-sun;
    in property <bool> showing-current: true;
    callback shift(int);
}

export struct NameValue {
    name: string,
    value: string,
}

export struct DiskRow {
    mount: string,
    // /boot, /efi and the like.
    system: bool,
    used: float,
    text: string,
}

export global Perf {
    in property <float> cpu;
    in property <float> mem;
    in property <[float]> cpu-history;
    in property <[float]> mem-history;
    in property <string> cpu-text;
    in property <string> mem-text;
    in property <string> temp-text;
    in property <string> net-text;
    in property <string> load-text;
    in property <[float]> cores;
    // Memory widget.
    in property <string> mem-used-text;
    in property <string> mem-avail-text;
    in property <float> swap;
    in property <string> swap-text;
    in property <[NameValue]> top-mem;
    // Network widget (both histories on one scale).
    in property <[float]> net-rx-history;
    in property <[float]> net-tx-history;
    in property <string> net-rx-text;
    in property <string> net-tx-text;
    in property <string> net-peak-text;
    in property <string> net-iface;
    in property <string> net-addr;
    in property <float> net-rx-frac;
    in property <float> net-tx-frac;
    // Disks widget.
    in property <[DiskRow]> disks;
    // `disks` without boot and firmware partitions.
    in property <[DiskRow]> user-disks;
    in property <[float]> disk-history;
    in property <string> disk-read-text;
    in property <string> disk-write-text;
    in property <float> root-used;
    // GPU widget.
    in property <bool> has-gpu;
    in property <string> gpu-name;
    in property <float> gpu-busy;
    in property <[float]> gpu-history;
    in property <float> gpu-vram;
    in property <string> gpu-vram-text;
    in property <string> gpu-temp-text;
    in property <string> gpu-power-text;
}

export struct ModelShare {
    name: string,
    share: float,
}

export global ClaudeUsage {
    in property <bool> loaded;
    in property <string> plan;
    in property <bool> window-active;
    in property <string> window-tokens;
    in property <string> window-count;
    in property <string> window-cached;
    in property <int> window-messages;
    in property <string> window-left;
    in property <float> window-progress;
    in property <string> window-resets;
    in property <string> burn;
    in property <string> today;
    in property <string> week;
    in property <[float]> hourly;
    in property <[ModelShare]> models;
}

export struct WinItem {
    id: int,
    header: bool,
    title: string,
    app: string,
    icon: image,
    has-icon: bool,
    focused: bool,
    urgent: bool,
}

export global Windows {
    in property <[WinItem]> items;
    in property <int> count;
    in property <image> focused-icon;
    in property <bool> has-focused-icon;
    in property <string> focused-app;
    in property <bool> available: true;
    callback focus(int);
    callback close(int);
}

export struct WifiNet {
    ssid: string,
    signal: int,
    secure: bool,
    active: bool,
    known: bool,
}

export global Wifi {
    in property <bool> available;
    in property <bool> enabled;
    in property <string> ssid;
    in property <int> signal;
    in property <[WifiNet]> networks;
    in property <string> status;
    in property <bool> busy;
    callback toggle();
    callback rescan();
    callback connect(string, string);
    callback disconnect();
}

export struct BtDevice {
    address: string,
    name: string,
    kind: string,
    connected: bool,
    paired: bool,
    battery: int,
    busy: bool,
}

export global Bluetooth {
    in property <bool> available;
    in property <bool> powered;
    in property <[BtDevice]> devices;
    in property <int> connected-count;
    in property <string> status;
    callback toggle();
    callback connect(string);
    callback disconnect(string);
}

export enum PowerProfile { power-saver, balanced, performance }

export enum DeviceKind { mouse, keyboard, headphones, gamepad, phone, other }

// A battery of a mouse, keyboard, headset and so on.
export struct Peripheral {
    kind: DeviceKind,
    name: string,
    percent: int,
}

// Something blocking sleep, from logind.
export struct Blocker {
    who: string,
    why: string,
    what: string,
}

export global Power {
    in property <[Peripheral]> peripherals;
    in property <[Blocker]> blockers;
    in property <bool> has-battery;
    in property <int> percent;
    in property <bool> charging;
    in property <bool> plugged;
    in property <string> status-text;
    in property <PowerProfile> profile;
    in property <bool> has-profile;
    in property <[PowerProfile]> profiles;
    in property <string> power-text;
    // Blocking sleep and screen locking by hand.
    in property <bool> inhibited;
    callback set-profile(PowerProfile);
    callback toggle-inhibit();
}

export struct AudioSink {
    id: int,
    name: string,
    default: bool,
}

// An app playing sound.
export struct AudioStream {
    id: int,
    app: string,
    icon: image,
    has-icon: bool,
    volume: float,
    muted: bool,
}

export global Audio {
    in property <[AudioSink]> sinks;
    in property <[AudioStream]> streams;
    callback set-stream-volume(int, float);
    callback toggle-stream-mute(int);
    callback set-default-sink(int);
    in property <bool> available;
    in-out property <float> volume;
    in property <bool> muted;
    in-out property <float> mic-volume;
    in property <bool> mic-muted;
    in property <string> sink-name;
    callback set-volume(float);
    callback toggle-mute();
    callback set-mic-volume(float);
    callback toggle-mic-mute();
}

export global Brightness {
    in property <bool> available;
    in-out property <float> level;
    callback set(float);
}

export struct Notif {
    id: int,
    app: string,
    summary: string,
    body: string,
    time: string,
    icon: image,
    has-icon: bool,
    has-default: bool,
    urgent: bool,
}

export global Notifications {
    in property <[Notif]> items;
    in property <bool> server;
    // Do not disturb: on, what it says ("Paused until 7:00"), and how many came in meanwhile.
    in property <bool> dnd;
    in property <string> dnd-text;
    in property <int> missed;
    // The time "until tomorrow" ends, e.g. "7:00".
    in property <string> morning: "7:00";
    // 0 off, 1 for an hour, 2 until tomorrow morning, 3 until turned off.
    callback set-dnd(int);
    callback dismiss(int);
    callback clear();
    callback invoke(int);
}

export struct TrayItem {
    id: string,
    title: string,
    icon: image,
    has-icon: bool,
    has-menu: bool,
}

export enum MenuToggle { none, check, radio }

export struct MenuEntry {
    id: int,
    label: string,
    depth: int,
    separator: bool,
    enabled: bool,
    toggle: MenuToggle,
    checked: bool,
    header: bool,
}

export global Tray {
    in property <[TrayItem]> items;
    in property <bool> available: true;
    // The open context menu, shown as an overlay at (menu-x, menu-y) in window coordinates.
    in property <bool> menu-open;
    in property <string> menu-title;
    in property <[MenuEntry]> menu;
    in property <length> menu-x;
    in property <length> menu-y;
    callback activate(string, length, length);
    callback open-menu(string, length, length);
    callback menu-activate(int);
    callback menu-close();
}

export struct ClaudeSession {
    pid: int,
    title: string,
    place: string,
    status: string,
    busy: bool,
    has-window: bool,
}

export global Claude {
    in property <[ClaudeSession]> sessions;
    in property <int> busy;
    callback focus(int);
}

export struct ClipItem {
    index: int,
    text: string,
    is-image: bool,
    image: image,
    info: string,
}

export global Clipboard {
    in property <[ClipItem]> items;
    in property <bool> available: true;
    callback copy(int);
    callback remove(int);
    callback clear();
}

export enum WeatherIcon { sun, moon, cloud-sun, cloud-moon, cloud, fog, rain, snow, storm }

export struct WeatherDay {
    name: string,
    icon: WeatherIcon,
    max: string,
    min: string,
}

export global Weather {
    in property <bool> loaded;
    in property <string> place;
    in property <string> temp;
    in property <string> feels;
    in property <string> description;
    in property <WeatherIcon> icon;
    in property <string> details;
    in property <[WeatherDay]> days;
    in property <string> error;
}

export global Media {
    in property <bool> available;
    in property <string> title;
    in property <string> artist;
    in property <string> player;
    in property <bool> playing;
    in property <image> art;
    in property <bool> has-art;
    in property <float> progress;
    in property <string> position-text;
    callback play-pause();
    callback next();
    callback previous();
}

export global Session {
    callback lock();
    callback suspend();
    callback logout();
    callback reboot();
    callback poweroff();
}

// What a mascot says. One entry per widget id (`lines[id]`); ids without a mascot are empty.
export struct MascotLine {
    text: string,
    outfit: Outfit,
    // Changes with every new line, so the mascot can duck and pop up again.
    seq: int,
    // Lines sent with `niri-dash say` still waiting after this one.
    queued: int,
    // A sent line (rather than a remark of its own).
    sent: bool,
}

export global Mascots {
    in property <[MascotLine]> lines;
    // The dashboard is up: blink and look around only then.
    in property <bool> awake;
    // Clicked: the next line (and the sent one goes away).
    callback next(int);
}

export struct LayoutItem {
    name: string,
    // The indicator text, e.g. "EN".
    short: string,
}

export global KeyboardLayouts {
    in property <bool> available;
    in property <[LayoutItem]> layouts;
    in property <int> current;
    callback next();
    callback prev();
    callback pick(int);
}

export struct PickedColor {
    color: color,
    hex: string,
    rgb: string,
    hsl: string,
}

export global ColorPicker {
    // Newest first.
    in property <[PickedColor]> colors;
    callback pick();
    callback copy(string);
}

// The timer and stopwatch widgets (shared by all of them).
export global Countdown {
    in property <string> text: "5:00";
    // Still to go: 1 at the start, 0 at the end.
    in property <float> fraction: 1;
    in property <bool> running;
    in property <bool> paused;
    // Just went off.
    in property <bool> done;
    callback toggle();
    callback reset();
    callback preset(int);
    callback adjust(int);
    in property <string> sw-text: "0:00.0";
    in property <bool> sw-running;
    // Started at all (running or paused with time on it).
    in property <bool> sw-started;
    in property <[string]> laps;
    callback sw-toggle();
    callback sw-lap();
    callback sw-reset();
}

// Sticky notes: each notes widget's text, by widget id.
export global Notes {
    in property <[string]> texts;
    in property <[string]> names;
    callback edited(int, string);
}

export enum PrivacyKind { mic, camera, screen }

export struct PrivacyItem {
    kind: PrivacyKind,
    app: string,
    // What is shared, for screen sharing.
    detail: string,
    // niri's session id, to stop a screen share.
    session: int,
}

export global Privacy {
    in property <bool> mic;
    in property <bool> camera;
    in property <bool> screen;
    in property <[PrivacyItem]> items;
    callback stop(int);
}
