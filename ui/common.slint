import { Theme } from "theme.slint";
import { Nav, NavMode } from "data.slint";

export component Icon inherits Image {
    in property <color> tint: Theme.text;
    in property <length> size: 18px;
    width: size;
    height: size;
    colorize: tint;
    image-fit: contain;
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 32px;
    in property <length> icon-size: size * 0.55;
    in property <color> tint: Theme.text;
    in property <color> fill: transparent;
    in property <bool> enabled: true;
    in property <bool> active;
    // Under the keyboard cursor.
    in property <bool> kfocus;
    callback clicked();
    // An icon says nothing: each use names the button with `accessible-label`.
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-item-selected: root.kfocus;
    accessible-action-default => { root.clicked(); }
    width: size;
    height: size;
    // Buttons follow the style's corners (round at the default, square with "sharp").
    border-radius: min(self.height / 2, Theme.radius-small);
    background: active ? Theme.accent-soft : touch.pressed ? Theme.pressed : touch.has-hover || kfocus ? Theme.hover : fill;
    border-width: kfocus ? 2px : 0px;
    border-color: Theme.accent;
    opacity: enabled ? 1 : 0.4;
    animate background { duration: 100ms * Theme.motion; }
    Icon {
        source: root.icon;
        size: root.icon-size;
        tint: root.active ? Theme.accent : root.tint;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <bool> kfocus;
    // Tight padding, for a row of choices that must fit in a narrow widget.
    in property <bool> compact;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-item-selected: root.kfocus;
    accessible-action-default => { root.clicked(); }
    height: 30px;
    border-width: kfocus ? 2px : 0px;
    border-color: primary ? Theme.text : Theme.accent;
    min-width: label.preferred-width + (has-icon ? 44px : compact ? 8px : 24px);
    border-radius: min(self.height / 2, Theme.radius-small);
    background: danger ? (touch.has-hover ? Theme.bad.with-alpha(0.33) : Theme.bad.with-alpha(0.2))
        : primary ? (touch.pressed ? Theme.accent.darker(0.2) : touch.has-hover ? Theme.accent.brighter(0.1) : Theme.accent)
        : (touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : Theme.card-raised);
    opacity: enabled ? 1 : 0.45;
    HorizontalLayout {
        padding-left: root.compact ? 4px : 12px;
        padding-right: root.compact ? 4px : 12px;
        spacing: 6px;
        alignment: center;
        if root.has-icon: Icon {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            size: 16px;
            tint: root.primary ? Theme.on-accent : root.danger ? Theme.bad : Theme.text;
        }
        label := Text {
            text: root.text;
            vertical-alignment: center;
            // A compact button gives way when the row is too narrow, rather than overflowing.
            overflow: root.compact ? TextOverflow.elide : TextOverflow.clip;
            font-size: Theme.font-body;
            color: root.primary ? Theme.on-accent : root.danger ? Theme.bad : Theme.text;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> kfocus;
    callback toggled();
    // Each use names the switch with `accessible-label`.
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-item-selected: root.kfocus;
    accessible-action-default => { root.toggled(); }
    width: 40px;
    height: 22px;
    border-radius: min(self.height / 2, Theme.radius-small);
    // Outside the track, so it shows on the accent color of a switch that is on.
    Rectangle {
        visible: root.kfocus;
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: min(self.height / 2, Theme.radius-small + 3px);
        border-width: 2px;
        border-color: Theme.accent;
    }
    background: checked ? Theme.accent : Theme.track;
    opacity: enabled ? 1 : 0.4;
    animate background { duration: 120ms * Theme.motion; }
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: min(self.height / 2, Theme.radius-small - 3px);
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        background: root.checked ? Theme.on-accent : Theme.dim;
        animate x { duration: 120ms * Theme.motion; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(); }
    }
}

// Arc from 12 o'clock clockwise, `value` in 0..1.
export component Ring inherits Rectangle {
    in property <float> value;
    in property <length> thickness: 8px;
    in property <color> tint: Theme.accent;
    in property <color> track: Theme.track;
    // A gauge: each use says what it measures with `accessible-label`.
    accessible-role: progress-indicator;
    accessible-value: Math.round(clamp(root.value, 0, 1) * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    // Gauges glide to a new value; a knob under the pointer, which glides by itself, says 0.
    in property <duration> glide: 0ms;
    property <float> v: clamp(value, 0, 0.9999);
    animate v { duration: root.glide; easing: ease-out; }
    property <float> r: 50 - (thickness / self.width) * 50 - 0.5;
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.track;
        stroke-width: root.thickness;
        commands: "M 50 " + (50 - root.r) + " A " + root.r + " " + root.r + " 0 1 1 " + (50 - 0.01) + " " + (50 - root.r) + " Z";
    }
    if root.v > 0.002: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: LineCap.round;
        commands: "M 50 " + (50 - root.r) + " A " + root.r + " " + root.r + " 0 " + (root.v > 0.5 ? "1" : "0") + " 1 "
            + (50 + root.r * sin(root.v * 360deg)) + " " + (50 - root.r * cos(root.v * 360deg));
    }
}

// A thin progress bar, `value` in 0..1.
export component Bar inherits Rectangle {
    in property <float> value;
    in property <color> tint: Theme.accent;
    in property <length> thickness: 6px;
    // Usage rather than progress: nearly full shows in the bad color.
    in property <bool> high-is-bad: true;
    // A gauge: each use says what it measures with `accessible-label`.
    accessible-role: progress-indicator;
    accessible-value: Math.round(clamp(root.value, 0, 1) * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    height: root.thickness;
    border-radius: root.thickness / 2;
    background: Theme.track;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: parent.border-radius;
        background: root.high-is-bad && root.value > 0.9 ? Theme.bad : root.tint;
        // New readings slide in rather than jump.
        animate width { duration: 300ms * Theme.motion; easing: ease-out; }
        animate background { duration: 200ms * Theme.motion; }
    }
}

// A round widget's gauge: a ring (and an inner one for a second value, if `inner` is set) around
// a big figure and a caption, or around the children.
export component RoundGauge inherits Rectangle {
    in property <float> value;
    in property <float> inner: -1;
    in property <color> tint: Theme.accent;
    in property <color> inner-tint: Theme.good;
    // Usage rather than progress: a nearly full outer ring shows in the bad color.
    in property <bool> high-is-bad: true;
    in property <string> big;
    in property <string> caption;
    // What the outer and the inner ring measure (the caption, unless said otherwise).
    in property <string> label: root.caption;
    in property <string> inner-label;
    Ring {
        accessible-label: root.label;
        width: 100%;
        height: 100%;
        value: root.value;
        glide: 400ms * Theme.motion;
        thickness: max(6px, root.width * 0.06);
        tint: root.high-is-bad && root.value > 0.9 ? Theme.bad : root.tint;
    }
    if root.inner >= 0: Ring {
        accessible-label: root.inner-label;
        width: 76%;
        height: 76%;
        value: root.inner;
        glide: 400ms * Theme.motion;
        thickness: max(5px, root.width * 0.05);
        tint: root.inner-tint;
    }
    VerticalLayout {
        alignment: center;
        if root.big != "": Text {
            text: root.big;
            horizontal-alignment: center;
            font-size: max(13px, root.width * 0.15);
            font-weight: Theme.font-weight-display;
            color: Theme.text;
        }
        if root.caption != "": Text {
            text: root.caption;
            horizontal-alignment: center;
            font-size: max(9px, root.width * 0.06);
            color: Theme.dim;
            overflow: elide;
        }
        @children
    }
}

// A round widget's face: a big icon over a title and a caption, each shown if set. `on` tints the
// background; a child TouchArea makes it a button.
export component RoundFace inherits Rectangle {
    in property <image> icon;
    // `transparent` keeps the icon's own colors (an app icon).
    in property <color> tint: Theme.dim;
    in property <string> title;
    // The title is a figure (a temperature): bigger, in the display weight.
    in property <bool> big;
    in property <string> caption;
    in property <bool> on;
    border-radius: self.width / 2;
    background: root.on ? Theme.accent-soft : transparent;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                size: root.width * 0.3;
                tint: root.tint;
            }
        }
        if root.title != "": Text {
            text: root.title;
            horizontal-alignment: center;
            font-size: root.big ? root.width * 0.2 : max(11px, root.width * 0.085);
            font-weight: root.big ? Theme.font-weight-display : 400;
            color: Theme.text;
            overflow: elide;
        }
        if root.caption != "": Text {
            text: root.caption;
            horizontal-alignment: center;
            font-size: max(10px, root.width * 0.075);
            color: Theme.dim;
            overflow: elide;
        }
    }
    @children
}

// A history line chart, newest sample on the right, `capacity` samples wide. A Path keeps its
// viewbox's aspect ratio, so the chart is drawn one segment per pair of neighbouring samples,
// each with a viewbox equal to its own size: drawn 1:1, any width and height.
export component Graph inherits Rectangle {
    in property <[float]> values;
    in property <int> capacity: 90;
    in property <color> tint: Theme.accent;
    // Off for a second line drawn on top of another graph.
    in property <bool> fill-area: true;
    property <length> step: self.width / max(1, self.capacity - 1);
    property <int> first: self.capacity - self.values.length;
    border-radius: min(8px, Theme.radius-small);
    background: Theme.subtle;
    clip: true;
    // Samples older than the capacity would be off the left edge: don't create them at all.
    for v[i] in root.values: Rectangle {
        if i + 1 >= -root.first: Rectangle {
            property <float> next: i + 1 < root.values.length ? root.values[i + 1] : v;
            property <float> w: self.width / 1px;
            property <float> h: self.height / 1px;
            property <float> y0: 2 + (1 - clamp(v, 0, 1)) * (self.h - 4);
            property <float> y1: 2 + (1 - clamp(self.next, 0, 1)) * (self.h - 4);
            visible: i + 1 < root.values.length;
            x: (root.first + i) * root.step;
            y: 0;
            // A hair wider than a step so neighbouring areas overlap instead of leaving seams.
            width: root.step + 0.5px;
            height: root.height;
            if root.fill-area: Path {
                width: 100%;
                height: 100%;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: parent.w;
                viewbox-height: parent.h;
                // Opaque (pre-mixed with the card color) so the overlap between segments is invisible.
                fill: root.tint.mix(Theme.card.with-alpha(1), 0.18);
                commands: "M 0 " + parent.y0 + " L " + parent.w + " " + parent.y1 + " L " + parent.w + " " + parent.h + " L 0 " + parent.h + " Z";
            }
            // The line as a thin filled band: Slint insets stroked paths by half the stroke width,
            // which would leave a gap at every join. Thickness 1.6 px, measured across the line.
            property <float> half: 0.8 * sqrt(1 + ((self.y1 - self.y0) / max(0.001, self.w)) * ((self.y1 - self.y0) / max(0.001, self.w)));
            Path {
                width: 100%;
                height: 100%;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: parent.w;
                viewbox-height: parent.h;
                fill: root.tint;
                commands: "M 0 " + (parent.y0 - parent.half) + " L " + parent.w + " " + (parent.y1 - parent.half)
                    + " L " + parent.w + " " + (parent.y1 + parent.half) + " L 0 " + (parent.y0 + parent.half) + " Z";
            }
        }
    }
}

export component Slider inherits Rectangle {
    in-out property <float> value;
    in property <color> tint: Theme.accent;
    in property <bool> enabled: true;
    in property <bool> kfocus;
    callback changed(float);
    // Each use names the slider with `accessible-label`.
    accessible-role: slider;
    accessible-value: Math.round(clamp(root.value, 0, 1) * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 5;
    accessible-enabled: root.enabled;
    accessible-item-selected: root.kfocus;
    accessible-action-increment => { root.step(0.05); }
    accessible-action-decrement => { root.step(-0.05); }
    function step(d: float) {
        root.value = clamp(root.value + d, 0, 1);
        root.changed(root.value);
    }
    height: 24px;
    property <length> knob: 16px;
    // What is drawn: it glides to `value` (a key step, a change from elsewhere), but follows
    // the pointer without lag while it drags.
    property <float> shown: root.value;
    animate shown { duration: touch.pressed ? 0ms : 100ms * Theme.motion; easing: ease-out; }
    opacity: enabled ? 1 : 0.4;
    Rectangle {
        y: (root.height - self.height) / 2;
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
    }
    Rectangle {
        x: 0;
        y: (root.height - self.height) / 2;
        width: clamp(root.shown, 0, 1) * (root.width - root.knob) + root.knob / 2;
        height: 6px;
        border-radius: 3px;
        background: root.tint;
    }
    Rectangle {
        x: clamp(root.shown, 0, 1) * (root.width - root.knob);
        y: (root.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: touch.pressed || touch.has-hover ? Theme.knob.brighter(0.2) : Theme.knob;
        border-width: root.kfocus ? 3px : 0px;
        border-color: Theme.accent;
    }
    function set-from(x: length) {
        root.value = clamp((x - root.knob / 2) / (root.width - root.knob), 0, 1);
        root.changed(root.value);
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
        scroll-event(e) => {
            root.value = clamp(root.value - (e.delta-y + e.delta-x) / 960px, 0, 1);
            root.changed(root.value);
            accept
        }
    }
}

// An icon, a slider and the value in percent. The icon is a button unless `icon-clickable` is off.
export component SliderRow inherits HorizontalLayout {
    in-out property <float> value;
    in property <image> icon;
    in property <color> icon-tint: Theme.text;
    in property <bool> icon-clickable: true;
    in property <length> icon-box: 32px;
    in property <color> tint: Theme.accent;
    in property <bool> enabled: true;
    // The keyboard cursor is on the icon (`kfocus-icon`) or on the slider (`kfocus`).
    in property <bool> kfocus;
    in property <bool> kfocus-icon;
    // What the slider sets ("Volume"), and what the icon button does ("Mute").
    in property <string> label;
    in property <string> icon-label;
    callback changed(float);
    callback icon-clicked();
    spacing: 8px;
    if root.icon-clickable: IconButton {
        y: (parent.height - self.height) / 2;
        size: root.icon-box;
        icon: root.icon;
        tint: root.icon-tint;
        kfocus: root.kfocus-icon;
        accessible-label: root.icon-label;
        clicked => { root.icon-clicked(); }
    }
    if !root.icon-clickable: Rectangle {
        y: (parent.height - self.height) / 2;
        width: root.icon-box;
        height: root.icon-box;
        Icon {
            source: root.icon;
            size: root.icon-box * 0.55;
            tint: root.icon-tint;
        }
    }
    Slider {
        y: (parent.height - self.height) / 2;
        value <=> root.value;
        tint: root.tint;
        enabled: root.enabled;
        kfocus: root.kfocus;
        accessible-label: root.label;
        changed(v) => { root.changed(v); }
    }
    Text {
        width: 38px;
        // The slider says it.
        accessible-role: none;
        text: Math.round(root.value * 100) + "%";
        color: Theme.dim;
        font-size: Theme.font-small;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

// Round knob: a ring showing `value`; scroll adjusts, click calls `clicked`.
export component RingKnob inherits Rectangle {
    in-out property <float> value;
    in property <color> tint: Theme.accent;
    in property <image> icon;
    in property <string> label;
    in property <bool> dimmed;
    in property <bool> kfocus;
    // What it sets ("Volume"); `label` is what it shows.
    in property <string> name;
    callback changed(float);
    callback clicked();
    accessible-role: slider;
    accessible-label: root.name;
    accessible-value: Math.round(clamp(root.value, 0, 1) * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 5;
    accessible-item-selected: root.kfocus;
    accessible-action-default => { root.clicked(); }
    accessible-action-increment => { root.step(0.05); }
    accessible-action-decrement => { root.step(-0.05); }
    function step(d: float) {
        root.value = clamp(root.value + d, 0, 1);
        root.changed(root.value);
    }
    border-radius: self.width / 2;
    background: root.kfocus ? Theme.hover : transparent;
    // Glides to `value`, so a key step doesn't jump.
    property <float> shown: root.value;
    animate shown { duration: 100ms * Theme.motion; easing: ease-out; }
    Ring {
        width: 100%;
        height: 100%;
        value: root.shown;
        thickness: max(6px, root.width * 0.07);
        tint: root.dimmed ? Theme.faint : root.tint;
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                size: min(root.width * 0.28, 40px);
                tint: root.dimmed ? Theme.faint : Theme.text;
            }
        }
        Text {
            // The knob says it.
            accessible-role: none;
            text: root.label;
            horizontal-alignment: center;
            font-size: max(11px, min(root.width * 0.11, 18px));
            color: Theme.dim;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
        scroll-event(e) => {
            root.value = clamp(root.value - (e.delta-y + e.delta-x) / 960px, 0, 1);
            root.changed(root.value);
            accept
        }
    }
}

// A widget's title row; the icon is optional, the children go on the right.
export component Header inherits HorizontalLayout {
    in property <image> icon;
    in property <string> title;
    in property <color> icon-color: Theme.dim;
    spacing: 8px;
    height: 28px;
    if root.icon.width > 0: Icon {
        y: (parent.height - self.height) / 2;
        source: root.icon;
        size: 18px;
        tint: root.icon-color;
    }
    Text {
        text: root.title;
        font-size: Theme.font-title;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    @children
}

export component Row inherits Rectangle {
    in property <bool> selected;
    in property <bool> enabled: true;
    // Under the keyboard cursor. A Row in a ScrollList scrolls into view through `revealed`.
    in property <bool> kfocus;
    // Under the keyboard cursor on a part of the row (its close button): the row scrolls into
    // view for that too.
    in property <bool> kfocus-part;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    callback middle-clicked();
    callback right-clicked(length, length);
    // The keyboard cursor came here: its position in the window and height.
    callback revealed(length, length);
    // Each use says what the row is with `accessible-label` (and how it stands with
    // `accessible-value`: "connected"). `selected` is for the eye; say it in the value.
    accessible-role: list-item;
    accessible-enabled: root.enabled;
    accessible-item-selected: root.kfocus;
    accessible-action-default => { root.clicked(); }
    changed kfocus => {
        if (self.kfocus) {
            self.revealed(self.absolute-position.y, self.height);
        }
    }
    changed kfocus-part => {
        if (self.kfocus-part) {
            self.revealed(self.absolute-position.y, self.height);
        }
    }
    // The list changed around it (a section appeared above): the cursor stays in sight.
    changed y => {
        if (self.kfocus || self.kfocus-part) {
            self.revealed(self.absolute-position.y, self.height);
        }
    }
    height: 36px;
    border-radius: min(self.height / 2, Theme.radius-small);
    background: selected ? Theme.accent-soft : touch.pressed ? Theme.pressed : touch.has-hover || kfocus ? Theme.hover : transparent;
    border-width: kfocus ? 2px : 0px;
    border-color: Theme.accent;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                root.middle-clicked();
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.right-clicked(self.mouse-x, self.mouse-y);
            }
        }
    }
    @children
}

// A small heading over a group of rows.
export component SectionLabel inherits Text {
    font-size: Theme.font-small;
    font-weight: 600;
    color: Theme.faint;
    vertical-alignment: bottom;
    overflow: elide;
}

export component Muted inherits Text {
    color: Theme.dim;
    font-size: Theme.font-small;
    vertical-alignment: center;
    overflow: elide;
}

export component Empty inherits Text {
    color: Theme.faint;
    font-size: Theme.font-body;
    horizontal-alignment: center;
    vertical-alignment: center;
    wrap: word-wrap;
}

// Signal strength as four bars.
export component SignalBars inherits Rectangle {
    in property <int> signal;
    in property <color> tint: Theme.text;
    width: 18px;
    height: 14px;
    for i in 4: Rectangle {
        x: i * 5px;
        width: 3px;
        height: (i + 1) * 3.5px;
        y: root.height - self.height;
        border-radius: 1px;
        background: root.signal > i * 25 ? root.tint : Theme.track;
    }
}

// A scrollable column whose scrollbar has its own gutter, so rows never sit under it. The gutter
// is always reserved (wrapped text would otherwise make width and height depend on each other)
// and the bar only shows when there is something to scroll.
export component ScrollList inherits Rectangle {
    property <bool> scrolls: flick.content-height > root.height + 1px;
    // Lists sit in a card's padding; the scrollbar goes there too, so rows are as wide as the
    // header above them and line up with its buttons. Only a tight padding needs a gutter.
    property <bool> in-padding: Theme.pad >= 8px;
    property <length> gutter: self.in-padding ? 0px : 10px;
    // Scroll just enough to show what sits at window position `y`, `h` high (a row the
    // keyboard cursor moved to).
    public function reveal(y: length, h: length) {
        // Where it is in the content, so a later change of size can bring it back into view.
        root.shown-y = y - flick.absolute-position.y - flick.content-y;
        root.shown-h = h;
        root.keep-in-view();
    }
    // What the keyboard cursor last asked to see, in the content's own coordinates.
    property <length> shown-y;
    property <length> shown-h;
    function keep-in-view() {
        let top = root.shown-y + flick.content-y;
        let lowest = min(0px, flick.height - flick.content-height);
        if (top < 0px) {
            flick.content-y = clamp(flick.content-y - top, lowest, 0px);
        } else if (top + root.shown-h > flick.height) {
            flick.content-y = clamp(flick.content-y - (top + root.shown-h - flick.height), lowest, 0px);
        }
    }
    // The widget was resized under the cursor: its row stays in sight.
    changed height => { root.keep-in-view(); }
    flick := Flickable {
        x: 0;
        width: root.width - root.gutter;
        height: root.height;
        // Only up and down: a row too wide for the list would otherwise make the whole column
        // wider than its view, and shift it sideways, out from under the scrollbar and the cursor.
        content-width: self.width;
        content-height: column.preferred-height;
        column := VerticalLayout {
            width: flick.width;
            @children
        }
    }
    if root.scrolls: Rectangle {
        x: root.in-padding ? root.width + (Theme.pad - self.width) / 2 : root.width - 5px;
        width: 4px;
        border-radius: 2px;
        background: Theme.subtle;
        Rectangle {
            property <length> thumb: max(24px, parent.height * root.height / flick.content-height);
            y: (parent.height - self.thumb) * clamp(-flick.content-y / max(1px, flick.content-height - root.height), 0, 1);
            height: self.thumb;
            border-radius: 2px;
            background: Theme.faint;
        }
    }
}

// Keyboard navigation inside a widget entered with its hint label (or a standalone app's widget).
// It takes the keyboard when the widget is entered and moves a cursor over `count` stops: j/k (and
// the arrows, Tab and Shift+Tab) step, g/G jump to the ends, h/l move between the `subs` parts of
// the stop (a row and its buttons) or else go to `adjust`. With no stops to step between (a knob,
// one slider), j/k go to `adjust` too: k (up) as +1, j (down) as -1. Enter goes to `activate`;
// other keys go to `letter`, Space too, and to `activate` if the widget doesn't take it; `e` is
// the dashboard's (it expands the widget), so it never gets to `letter`. Escape coming up from a text field inside
// takes the keyboard back; otherwise `back` gets a chance (close a prompt, leave a page) before
// the dashboard leaves the widget.
//
// For screen readers and the tests: a NavScope is an accessible list of its `count` stops, named
// by each use with `accessible-label` (the widget's name). The element under the cursor says so
// with `accessible-item-selected: true` (the shared buttons, rows and sliders do it from their
// `kfocus`), so what the keyboard is on can be found and read out: exactly one visible element in
// the widget's tile (the controls are often beside the scope, not inside it), while the widget is
// entered and has stops. A widget's own `selected` look is said in its label or value instead.
export component NavScope inherits FocusScope {
    in property <bool> active;
    in property <int> count;
    accessible-role: list;
    accessible-item-count: root.count;
    // How many parts the stop under the cursor has (1: just itself).
    in property <int> subs: 1;
    // How far j/k move (a grid's row length).
    in property <int> stride: 1;
    in-out property <int> cursor;
    in-out property <int> sub;
    // h/l (-1/+1) on a stop without parts; true if it did something.
    callback adjust(int, int) -> bool;
    callback activate(int, int);
    // Any other key: the event's text, the cursor. True if the widget took it.
    callback letter(string, int) -> bool;
    callback back() -> bool;
    // A stop the cursor passes over (a section heading); up to four in a row are skipped.
    callback skip(int) -> bool;
    // Sees every key first (while the widget shows a menu, say); true if it took it.
    callback filter(string) -> bool;
    // The cursor shows only while the widget is entered.
    out property <bool> on: self.active && Nav.mode == NavMode.widget;
    focus-on-click: false;
    // Not a stop for Tab: Tab goes from text field to text field, as before.
    focus-on-tab-navigation: false;
    property <int> want: self.active ? Nav.tick : -1;
    changed want => {
        if (self.active) {
            self.focus();
        }
    }
    init => {
        if (self.active) {
            self.focus();
        }
    }
    changed count => {
        if (self.cursor >= self.count) {
            self.cursor = max(0, self.count - 1);
            self.sub = 0;
        }
        self.go(self.cursor, 1);
    }
    changed on => {
        if (self.on) {
            self.go(self.cursor, 1);
        }
    }
    function fit(c: int) -> int {
        clamp(c, 0, max(0, self.count - 1))
    }
    // Past a skipped stop, in direction d.
    function past(c: int, d: int) -> int {
        self.skip(c) ? self.fit(c + d) : c
    }
    // Moves to c, or on past skipped stops in direction d (staying put if all are skipped).
    function go(c: int, d: int) {
        let n = self.past(self.past(self.past(self.past(self.fit(c), d), d), d), d);
        if (!self.skip(n) && n != self.cursor) {
            self.cursor = n;
            self.sub = 0;
        }
    }
    // Put the cursor on c (or past skipped stops after it).
    public function move-to(c: int) {
        self.go(c, 1);
    }
    key-pressed(e) => {
        if (!self.on) {
            return reject;
        }
        if (e.text == Key.Escape) {
            if (!self.has-focus) {
                self.focus();
                return accept;
            }
            return self.back() ? accept : reject;
        }
        if (!self.has-focus) {
            // Something inside (a text field) has the keyboard and passed this key on.
            return reject;
        }
        if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta) {
            return reject;
        }
        if (self.filter(e.text)) {
            return accept;
        }
        if (e.text == Key.Tab || e.text == Key.Backtab) {
            let d = e.text == Key.Tab ? 1 : -1;
            if (self.count > 1) {
                self.go(self.fit(self.cursor + d), d);
            }
            return accept;
        }
        if (e.text == "j" || e.text == Key.DownArrow || e.text == "k" || e.text == Key.UpArrow) {
            let down = e.text == "j" || e.text == Key.DownArrow;
            if (self.count <= 1) {
                self.adjust(self.cursor, down ? -1 : 1);
            } else if (down && self.cursor + self.stride < self.count) {
                self.go(self.cursor + self.stride, 1);
            } else if (!down && self.cursor - self.stride >= 0) {
                self.go(self.cursor - self.stride, -1);
            }
            return accept;
        }
        if (e.text == "g" || e.text == Key.Home) {
            self.go(0, 1);
            return accept;
        }
        if (e.text == "G" || e.text == Key.End) {
            self.go(self.count - 1, -1);
            return accept;
        }
        if (e.text == "h" || e.text == Key.LeftArrow || e.text == "l" || e.text == Key.RightArrow) {
            let d = e.text == "h" || e.text == Key.LeftArrow ? -1 : 1;
            if (self.subs > 1) {
                self.sub = clamp(self.sub + d, 0, self.subs - 1);
                return accept;
            }
            return self.adjust(self.cursor, d) ? accept : reject;
        }
        // Space is the widget's own first (play / pause, say), else the same as Enter.
        if (e.text == Key.Return || (e.text == " " && !self.letter(e.text, self.cursor))) {
            self.activate(self.cursor, min(self.sub, self.subs - 1));
            return accept;
        }
        if (e.text == " ") {
            return accept;
        }
        if (e.text == Key.Backspace) {
            return self.back() ? accept : reject;
        }
        if (e.text == "e") {
            return reject;
        }
        self.letter(e.text, self.cursor) ? accept : reject
    }
    @children
}
