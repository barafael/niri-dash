import { LineEdit } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Wifi, Bluetooth, BtDevice, DeviceKind } from "../data.slint";
import { Icon, IconButton, TextButton, Switch, Header, Row, SectionLabel, Muted, Empty, SignalBars, ScrollList, RoundFace } from "../common.slint";

// A row of choices, one of them picked (security type, EAP method).
component Choice inherits HorizontalLayout {
    in property <[string]> options;
    in-out property <int> picked;
    spacing: 4px;
    for o[i] in root.options: TextButton {
        text: o;
        primary: i == root.picked;
        horizontal-stretch: 1;
        clicked => { root.picked = i; }
    }
}

// A password field (the LineEdit has its own button to show what was typed).
component PasswordField inherits HorizontalLayout {
    in property <string> placeholder: "Password";
    in property <bool> focus-first;
    in-out property <string> text <=> field.text;
    callback accepted();
    field := LineEdit {
        input-type: password;
        placeholder-text: root.placeholder;
        accepted => { root.accepted(); }
        init => {
            if (root.focus-first) {
                self.focus();
            }
        }
    }
}

// For a new Enterprise network: the domain the server's certificate must be issued for, or an
// explicit "don't check" (an evil twin could then take the password).
component ServerCheck inherits VerticalLayout {
    in-out property <string> domain;
    in-out property <bool> insecure;
    spacing: 6px;
    if !root.insecure: LineEdit {
        placeholder-text: "Server domain, e.g. example.org";
        text <=> root.domain;
    }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "Don't check the server (unsafe)";
            color: root.insecure ? Theme.warn : Theme.dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Switch {
            y: (parent.height - self.height) / 2;
            checked: root.insecure;
            toggled => { root.insecure = !root.insecure; }
        }
    }
}

// The prompt for a network's password: asked by the widget for a new network, or by
// NetworkManager (through the secret agent) for a saved one.
component WifiPasswordPrompt inherits Rectangle {
    property <bool> enterprise: Wifi.prompt.kind == 2;
    property <bool> new-enterprise: root.enterprise && Wifi.prompt.new;
    property <int> method;
    property <string> identity;
    property <string> password;
    property <string> domain;
    property <bool> insecure;
    // A new prompt (another network, or another request) starts empty, so nothing typed for
    // one network is sent to another.
    property <int> serial: Wifi.prompt.serial;
    changed serial => { root.reset(); }
    init => { root.reset(); }
    border-radius: Theme.radius-small;
    background: Theme.card-raised;
    VerticalLayout {
        padding: Theme.pad-tight;
        spacing: 6px;
        Text {
            text: (Wifi.prompt.retry ? "Wrong password for " : root.enterprise ? "Sign in to " : "Password for ") + Wifi.prompt.ssid;
            color: Wifi.prompt.retry ? Theme.warn : Theme.text;
            font-size: Theme.font-small;
            font-weight: 600;
            overflow: elide;
        }
        if root.new-enterprise: Choice {
            options: ["PEAP", "TTLS"];
            picked <=> root.method;
        }
        if root.enterprise: LineEdit {
            placeholder-text: "User name";
            text <=> root.identity;
            init => { self.focus(); }
        }
        PasswordField {
            placeholder: Wifi.prompt.kind == 1 ? "WEP key" : "Password";
            focus-first: !root.enterprise;
            text <=> root.password;
            accepted => { root.submit(); }
        }
        if root.new-enterprise: ServerCheck {
            domain <=> root.domain;
            insecure <=> root.insecure;
        }
        if Wifi.prompt.message != "": Text {
            text: Wifi.prompt.message;
            color: Theme.bad;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            TextButton {
                text: "Cancel";
                clicked => { Wifi.cancel-prompt(); }
            }
            TextButton {
                text: "Join";
                primary: true;
                clicked => { root.submit(); }
            }
        }
    }
    function reset() {
        root.identity = Wifi.prompt.identity;
        root.password = "";
        root.domain = "";
        root.insecure = false;
        root.method = 0;
    }
    function submit() {
        Wifi.answer(Wifi.prompt.serial, root.identity, root.password, root.method, root.domain, root.insecure);
        root.password = "";
    }
}

export component WifiWidget inherits Rectangle {
    in property <bool> round;
    // 0: networks, 1: one network's details, 2: join a hidden network, 3: saved networks.
    property <int> page;
    // Where the details page goes back to.
    property <int> back-to;
    property <bool> asking: Wifi.prompt.ssid != "";
    // The details page of the network with this key.
    function open(key: string, from: int) {
        root.back-to = from;
        root.page = 1;
        Wifi.select(key);
    }
    function back() {
        if (root.page == 1) {
            Wifi.select("");
            Wifi.hide-secret();
            root.page = root.back-to;
        } else {
            root.reset-hidden();
            root.page = 0;
        }
    }
    // The hidden-network form starts empty, and forgets what was typed once used or left.
    function reset-hidden() {
        root.hidden-ssid = "";
        root.hidden-security = 1;
        root.hidden-identity = "";
        root.hidden-password = "";
        root.hidden-method = 0;
        root.hidden-domain = "";
        root.hidden-insecure = false;
    }
    if root.round: RoundFace {
        icon: Wifi.enabled ? Icons.wifi : Icons.wifi-off;
        on: Wifi.enabled && Wifi.ssid != "";
        tint: self.on ? Theme.accent : Theme.faint;
        title: !Wifi.available ? "No Wi-Fi" : !Wifi.enabled ? "Off" : Wifi.ssid != "" ? Wifi.ssid : "Not connected";
        caption: Wifi.enabled && Wifi.ssid != "" ? Wifi.signal + "%" : "";
        TouchArea {
            clicked => { Wifi.toggle(); }
        }
    }
    if !root.round: VerticalLayout {
        padding: Theme.pad;
        spacing: 6px;
        if root.page == 0: Header {
            icon: Wifi.enabled ? Icons.wifi : Icons.wifi-off;
            icon-color: Wifi.enabled ? Theme.accent : Theme.faint;
            title: "Wi-Fi";
            IconButton {
                icon: Icons.refresh;
                size: 28px;
                enabled: Wifi.enabled && !Wifi.scanning;
                clicked => { Wifi.rescan(); }
            }
            Switch {
                y: (parent.height - self.height) / 2;
                checked: Wifi.enabled;
                enabled: Wifi.available && !Wifi.blocked;
                toggled => { Wifi.toggle(); }
            }
        }
        if root.page != 0: HorizontalLayout {
            height: 28px;
            spacing: 4px;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.chevron-left;
                size: 28px;
                clicked => { root.back(); }
            }
            Text {
                text: root.page == 1 ? Wifi.detail.ssid : root.page == 2 ? "Hidden network" : "Saved networks";
                font-size: Theme.font-title;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        Muted {
            text: Wifi.status;
            color: Wifi.failed ? Theme.bad : Theme.dim;
            visible: Wifi.status != "";
            wrap: word-wrap;
        }
        if root.asking: WifiPasswordPrompt { }
        if !Wifi.available: Empty {
            vertical-stretch: 1;
            text: "No Wi-Fi device (NetworkManager)";
        }
        if Wifi.available && Wifi.blocked: Empty {
            vertical-stretch: 1;
            text: "Wi-Fi is blocked (airplane mode or a hardware switch)";
        }
        if Wifi.available && !Wifi.blocked && !Wifi.enabled && root.page == 0: Empty {
            vertical-stretch: 1;
            text: "Wi-Fi is off";
        }
        // The networks around, then the ways to the other pages.
        if Wifi.available && Wifi.enabled && root.page == 0: ScrollList {
            vertical-stretch: 1;
            if Wifi.portal: Row {
                background: self.hovered ? Theme.warn.with-alpha(0.3) : Theme.warn.with-alpha(0.18);
                clicked => { Wifi.sign-in(); }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        source: Icons.globe;
                        size: 16px;
                        tint: Theme.warn;
                    }
                    Text {
                        text: "Sign in to the network";
                        color: Theme.text;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
            for n in Wifi.networks: Row {
                selected: n.active;
                clicked => {
                    if (n.active) {
                        root.open(n.key, 0);
                    } else {
                        Wifi.connect(n.key);
                    }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 2px;
                    spacing: 8px;
                    SignalBars {
                        y: (parent.height - self.height) / 2;
                        signal: n.signal;
                        tint: n.active ? Theme.accent : Theme.text;
                    }
                    Text {
                        text: n.ssid;
                        color: n.active ? Theme.accent : Theme.text;
                        font-size: Theme.font-body;
                        font-weight: n.known ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if n.key == Wifi.connecting: Muted {
                        text: "joining…";
                    }
                    if n.tag != "": Muted {
                        text: n.tag;
                        color: n.secure ? Theme.dim : Theme.warn;
                    }
                    if n.secure: Icon {
                        y: (parent.height - self.height) / 2;
                        source: Icons.lock-small;
                        size: 14px;
                        tint: Theme.faint;
                    }
                    if n.active: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.close;
                        size: 26px;
                        clicked => { Wifi.disconnect(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.chevron-right;
                        size: 26px;
                        tint: Theme.dim;
                        clicked => { root.open(n.key, 0); }
                    }
                }
            }
            if Wifi.networks.length == 0: Empty {
                height: 48px;
                text: Wifi.scanning ? "Scanning…" : "No networks found";
            }
            Row {
                clicked => {
                    root.reset-hidden();
                    root.page = 2;
                }
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        source: Icons.plus;
                        size: 16px;
                        tint: Theme.dim;
                    }
                    Text {
                        text: "Hidden network…";
                        color: Theme.dim;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
            if Wifi.saved.length > 0: Row {
                clicked => { root.page = 3; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 2px;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        source: Icons.check;
                        size: 16px;
                        tint: Theme.dim;
                    }
                    Text {
                        text: "Saved networks (" + Wifi.saved.length + ")";
                        color: Theme.dim;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Icon {
                        y: (parent.height - self.height) / 2;
                        source: Icons.chevron-right;
                        size: 16px;
                        tint: Theme.dim;
                    }
                }
            }
        }
        // One network: what NetworkManager knows about it, and what can be done with it.
        if Wifi.available && root.page == 1: ScrollList {
            vertical-stretch: 1;
            if Wifi.detail.ssid == "": Empty {
                height: 48px;
                text: "This network is gone.";
            }
            for f in Wifi.detail.facts: HorizontalLayout {
                height: 24px;
                spacing: 8px;
                Muted {
                    text: f.label;
                    width: 34%;
                }
                Text {
                    text: f.value;
                    color: Theme.text;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            if Wifi.detail.known: HorizontalLayout {
                height: 34px;
                spacing: 8px;
                Text {
                    text: "Connect automatically";
                    color: Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Switch {
                    y: (parent.height - self.height) / 2;
                    checked: Wifi.detail.autoconnect;
                    toggled => { Wifi.set-autoconnect(Wifi.detail.uuid, !Wifi.detail.autoconnect); }
                }
            }
            if Wifi.detail.known && Wifi.revealed: VerticalLayout {
                spacing: 6px;
                padding-top: 4px;
                if Wifi.password != "": HorizontalLayout {
                    spacing: 8px;
                    Muted {
                        text: "Password";
                        width: 34%;
                    }
                    Text {
                        text: Wifi.password;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: Wifi.qr;
                        width: min(160px, root.width - 2 * Theme.pad);
                        height: self.width;
                        image-rendering: pixelated;
                    }
                }
                Muted {
                    text: "Scan with a phone camera to join.";
                    horizontal-alignment: center;
                }
            }
            HorizontalLayout {
                padding-top: 6px;
                spacing: 6px;
                alignment: end;
                if Wifi.detail.known: TextButton {
                    text: "Forget";
                    danger: true;
                    clicked => {
                        Wifi.forget(Wifi.detail.uuid);
                        root.back();
                    }
                }
                if Wifi.detail.known: TextButton {
                    text: Wifi.revealed ? "Hide" : "Share";
                    clicked => {
                        if (Wifi.revealed) {
                            Wifi.hide-secret();
                        } else {
                            Wifi.reveal(Wifi.detail.uuid);
                        }
                    }
                }
                if Wifi.detail.active: TextButton {
                    text: "Disconnect";
                    clicked => { Wifi.disconnect(); }
                }
                if !Wifi.detail.active && Wifi.detail.ssid != "": TextButton {
                    text: "Connect";
                    primary: true;
                    enabled: Wifi.enabled;
                    clicked => { Wifi.connect(Wifi.detail.key); }
                }
            }
        }
        // A network that doesn't broadcast its name.
        if Wifi.available && Wifi.enabled && root.page == 2: ScrollList {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                LineEdit {
                    placeholder-text: "Network name (SSID)";
                    text <=> root.hidden-ssid;
                    init => { self.focus(); }
                }
                Choice {
                    options: ["Open", "WPA", "802.1X"];
                    picked <=> root.hidden-security;
                }
                if root.hidden-security == 2: Choice {
                    options: ["PEAP", "TTLS"];
                    picked <=> root.hidden-method;
                }
                if root.hidden-security == 2: LineEdit {
                    placeholder-text: "User name";
                    text <=> root.hidden-identity;
                }
                // Bound both ways: what is sent is what the field shows.
                if root.hidden-security != 0: PasswordField {
                    text <=> root.hidden-password;
                }
                if root.hidden-security == 2: ServerCheck {
                    domain <=> root.hidden-domain;
                    insecure <=> root.hidden-insecure;
                }
                HorizontalLayout {
                    alignment: end;
                    TextButton {
                        text: "Join";
                        primary: true;
                        enabled: root.hidden-ssid != "";
                        clicked => {
                            Wifi.join-hidden(root.hidden-ssid, root.hidden-security, root.hidden-identity, root.hidden-password, root.hidden-method, root.hidden-domain, root.hidden-insecure);
                            root.reset-hidden();
                            root.page = 0;
                        }
                    }
                }
            }
        }
        // Every saved network, last used first; in range or not.
        if Wifi.available && root.page == 3: ScrollList {
            vertical-stretch: 1;
            for s in Wifi.saved: Row {
                clicked => { root.open(s.key, 3); }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 2px;
                    spacing: 8px;
                    Text {
                        text: s.ssid;
                        color: s.ssid == Wifi.ssid ? Theme.accent : Theme.text;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Muted {
                        text: s.detail;
                    }
                    Icon {
                        y: (parent.height - self.height) / 2;
                        source: Icons.chevron-right;
                        size: 16px;
                        tint: Theme.dim;
                    }
                }
            }
        }
    }
    property <string> hidden-ssid;
    property <int> hidden-security: 1;
    property <string> hidden-identity;
    property <string> hidden-password;
    property <int> hidden-method;
    property <string> hidden-domain;
    property <bool> hidden-insecure;
}

// A Bluetooth device's icon, by what it is.
component DeviceIcon inherits Icon {
    in property <DeviceKind> kind;
    source: root.kind == DeviceKind.mouse ? Icons.mouse
        : root.kind == DeviceKind.keyboard ? Icons.keyboard
        : root.kind == DeviceKind.headphones ? Icons.headphones
        : root.kind == DeviceKind.gamepad ? Icons.gamepad
        : root.kind == DeviceKind.phone ? Icons.phone : Icons.bluetooth;
    size: 16px;
}

// A pairing prompt: compare a code, type one, or type one shown here on the device.
component BtPairingPrompt inherits Rectangle {
    property <int> kind: Bluetooth.prompt.kind;
    // Asks for a code (2: PIN, 3: passkey).
    property <bool> asks-code: root.kind == 2 || root.kind == 3;
    // Shows a code to type on the device.
    property <bool> shows-code: root.kind == 4 || root.kind == 5;
    property <string> code;
    // A new prompt starts empty.
    property <int> serial: Bluetooth.prompt.serial;
    changed serial => { root.code = ""; }
    border-radius: Theme.radius-small;
    background: Theme.card-raised;
    VerticalLayout {
        padding: Theme.pad-tight;
        spacing: 6px;
        Text {
            text: root.kind == 1 ? "Pair with " + Bluetooth.prompt.name + "?"
                : root.asks-code ? (root.kind == 2 ? "PIN for " : "Passkey for ") + Bluetooth.prompt.name
                : root.shows-code ? "Type this on " + Bluetooth.prompt.name + ", then Enter"
                : "Allow " + Bluetooth.prompt.name + " to pair?";
            color: Theme.text;
            font-size: Theme.font-small;
            font-weight: 600;
            wrap: word-wrap;
        }
        // The address too: the name is whatever the device says it is.
        Muted {
            text: Bluetooth.prompt.address;
        }
        if root.kind == 1 || root.shows-code: Text {
            text: Bluetooth.prompt.code;
            color: Theme.accent;
            font-size: Theme.font-title * 1.6;
            font-weight: 600;
            horizontal-alignment: center;
            letter-spacing: 3px;
        }
        if root.kind == 1: Muted {
            text: "Pair only if the device shows the same number.";
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.kind == 5 && Bluetooth.prompt.entered > 0: Muted {
            text: Bluetooth.prompt.entered + " of 6 typed";
            horizontal-alignment: center;
        }
        if root.asks-code: LineEdit {
            placeholder-text: root.kind == 2 ? "PIN (often 0000)" : "6-digit passkey";
            input-type: root.kind == 3 ? InputType.number : InputType.text;
            text <=> root.code;
            init => { self.focus(); }
            accepted => { Bluetooth.answer(Bluetooth.prompt.serial, true, root.code); }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            TextButton {
                text: root.kind == 1 || root.kind == 6 ? "No" : "Cancel";
                clicked => {
                    if (root.shows-code) {
                        Bluetooth.cancel-pairing();
                    } else {
                        Bluetooth.answer(Bluetooth.prompt.serial, false, "");
                    }
                }
            }
            if !root.shows-code: TextButton {
                text: root.kind == 1 ? "Yes, they match" : root.kind == 6 ? "Allow" : "Pair";
                primary: true;
                enabled: !root.asks-code || root.code != "";
                clicked => { Bluetooth.answer(Bluetooth.prompt.serial, true, root.code); }
            }
        }
    }
}

// One device: icon, name, and what's worth knowing at a glance.
component BtRow inherits Row {
    in property <BtDevice> device;
    callback details();
    selected: root.device.connected;
    enabled: !root.device.busy;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 2px;
        spacing: 8px;
        DeviceIcon {
            y: (parent.height - self.height) / 2;
            kind: root.device.kind;
            tint: root.device.connected ? Theme.accent : Theme.dim;
        }
        Text {
            text: root.device.name;
            color: root.device.connected ? Theme.accent : Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Muted {
            text: root.device.busy ? "…"
                : root.device.blocked ? "blocked"
                : !root.device.paired && root.device.connected ? "not paired"
                : root.device.battery >= 0 ? root.device.battery + "%" : "";
            color: (!root.device.paired && root.device.connected) || root.device.blocked ? Theme.warn : Theme.dim;
        }
        if root.device.signal >= 0: SignalBars {
            y: (parent.height - self.height) / 2;
            signal: root.device.signal * 25;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.chevron-right;
            size: 26px;
            tint: Theme.dim;
            clicked => { root.details(); }
        }
    }
}

export component BluetoothWidget inherits Rectangle {
    in property <bool> round;
    // 0: devices, 1: one device's details.
    property <int> page;
    property <string> rename-to;
    function open(address: string) {
        root.rename-to = "";
        root.page = 1;
        Bluetooth.select(address);
    }
    function back() {
        Bluetooth.select("");
        root.page = 0;
    }
    if root.round: RoundFace {
        icon: Icons.bluetooth;
        on: Bluetooth.powered;
        tint: self.on ? Theme.accent : Theme.faint;
        title: !Bluetooth.available ? "No adapter" : Bluetooth.blocked ? "Blocked" : !Bluetooth.powered ? "Off" : Bluetooth.connected-count > 0 ? Bluetooth.connected-count + " connected" : "On";
        TouchArea {
            clicked => { Bluetooth.toggle(); }
        }
    }
    if !root.round: VerticalLayout {
        padding: Theme.pad;
        spacing: 6px;
        if root.page == 0: Header {
            icon: Icons.bluetooth;
            icon-color: Bluetooth.powered ? Theme.accent : Theme.faint;
            title: "Bluetooth";
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.plus;
                size: 28px;
                active: Bluetooth.discovering;
                enabled: Bluetooth.powered;
                clicked => { Bluetooth.scan(!Bluetooth.discovering); }
            }
            Switch {
                y: (parent.height - self.height) / 2;
                checked: Bluetooth.powered;
                enabled: Bluetooth.available && !Bluetooth.blocked;
                toggled => { Bluetooth.toggle(); }
            }
        }
        if root.page == 1: HorizontalLayout {
            height: 28px;
            spacing: 4px;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.chevron-left;
                size: 28px;
                clicked => { root.back(); }
            }
            Text {
                text: Bluetooth.detail.name;
                font-size: Theme.font-title;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        Muted {
            text: Bluetooth.status;
            color: Bluetooth.failed ? Theme.bad : Theme.dim;
            visible: Bluetooth.status != "";
            wrap: word-wrap;
        }
        if Bluetooth.prompt.address != "": BtPairingPrompt { }
        if !Bluetooth.available: Empty {
            vertical-stretch: 1;
            text: "No Bluetooth adapter";
        }
        if Bluetooth.available && Bluetooth.blocked: Empty {
            vertical-stretch: 1;
            text: "Bluetooth is blocked (airplane mode or a hardware switch)";
        }
        if Bluetooth.available && !Bluetooth.blocked && !Bluetooth.powered: Empty {
            vertical-stretch: 1;
            text: "Bluetooth is off";
        }
        // Paired devices, then what a scan finds.
        if Bluetooth.available && Bluetooth.powered && root.page == 0: ScrollList {
            vertical-stretch: 1;
            for d in Bluetooth.devices: BtRow {
                device: d;
                clicked => {
                    if (d.blocked) {
                        root.open(d.address);
                    } else if (d.connected) {
                        Bluetooth.disconnect(d.address);
                    } else {
                        Bluetooth.connect(d.address);
                    }
                }
                details => { root.open(d.address); }
            }
            if Bluetooth.devices.length == 0 && !Bluetooth.discovering: Empty {
                height: 48px;
                text: "No paired devices";
            }
            if Bluetooth.discovering || Bluetooth.nearby.length > 0: SectionLabel {
                height: 26px;
                text: Bluetooth.discovering ? "Nearby (looking…)" : "Nearby";
            }
            for d in Bluetooth.nearby: BtRow {
                device: d;
                clicked => { Bluetooth.pair(d.address); }
                details => { root.open(d.address); }
            }
            if Bluetooth.discovering && Bluetooth.nearby.length == 0: Muted {
                height: 30px;
                text: "Put the device into pairing mode.";
            }
            if Bluetooth.unnamed > 0: Muted {
                height: 24px;
                text: "+ " + Bluetooth.unnamed + (Bluetooth.unnamed == 1 ? " device" : " devices") + " without a name";
            }
            Row {
                clicked => { Bluetooth.scan(!Bluetooth.discovering); }
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        source: Bluetooth.discovering ? Icons.close : Icons.plus;
                        size: 16px;
                        tint: Theme.dim;
                    }
                    Text {
                        text: Bluetooth.discovering ? "Stop looking" : "Add a device…";
                        color: Theme.dim;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
        // One device: what BlueZ knows, and what can be done with it.
        if Bluetooth.available && root.page == 1: ScrollList {
            vertical-stretch: 1;
            if Bluetooth.detail.address == "": Empty {
                height: 48px;
                text: "This device is gone.";
            }
            for f in Bluetooth.detail.facts: HorizontalLayout {
                height: 24px;
                spacing: 8px;
                Muted {
                    text: f.label;
                    width: 34%;
                }
                Text {
                    text: f.value;
                    color: Theme.text;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            if Bluetooth.detail.paired: HorizontalLayout {
                height: 34px;
                spacing: 8px;
                Text {
                    text: "Connect automatically";
                    color: Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Switch {
                    y: (parent.height - self.height) / 2;
                    checked: Bluetooth.detail.trusted;
                    toggled => { Bluetooth.set-trusted(Bluetooth.detail.address, !Bluetooth.detail.trusted); }
                }
            }
            if Bluetooth.detail.address != "": HorizontalLayout {
                height: 34px;
                spacing: 8px;
                Text {
                    text: "Block";
                    color: Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Switch {
                    y: (parent.height - self.height) / 2;
                    checked: Bluetooth.detail.blocked;
                    toggled => { Bluetooth.set-blocked(Bluetooth.detail.address, !Bluetooth.detail.blocked); }
                }
            }
            if Bluetooth.detail.paired: HorizontalLayout {
                spacing: 6px;
                LineEdit {
                    placeholder-text: "Rename";
                    text <=> root.rename-to;
                    accepted => {
                        Bluetooth.rename(Bluetooth.detail.address, root.rename-to);
                        root.rename-to = "";
                    }
                }
                TextButton {
                    text: "Rename";
                    enabled: root.rename-to != "";
                    clicked => {
                        Bluetooth.rename(Bluetooth.detail.address, root.rename-to);
                        root.rename-to = "";
                    }
                }
            }
            HorizontalLayout {
                padding-top: 6px;
                spacing: 6px;
                alignment: end;
                if Bluetooth.detail.paired: TextButton {
                    text: "Forget";
                    danger: true;
                    clicked => {
                        Bluetooth.forget(Bluetooth.detail.address);
                        root.back();
                    }
                }
                if Bluetooth.detail.connected: TextButton {
                    text: "Disconnect";
                    clicked => { Bluetooth.disconnect(Bluetooth.detail.address); }
                }
                if !Bluetooth.detail.connected && Bluetooth.detail.paired && !Bluetooth.detail.blocked: TextButton {
                    text: "Connect";
                    primary: true;
                    enabled: Bluetooth.powered;
                    clicked => { Bluetooth.connect(Bluetooth.detail.address); }
                }
                if !Bluetooth.detail.paired && Bluetooth.detail.address != "" && !Bluetooth.detail.blocked: TextButton {
                    text: "Pair";
                    primary: true;
                    enabled: Bluetooth.powered;
                    clicked => {
                        Bluetooth.pair(Bluetooth.detail.address);
                        root.back();
                    }
                }
            }
        }
    }
}
