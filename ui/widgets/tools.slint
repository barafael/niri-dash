// Small tools: keyboard layout, color picker, timer and stopwatch, sticky notes, clipboard
// history.
import { Theme, Icons } from "../theme.slint";
import { KeyboardLayouts, LayoutItem, ColorPicker, PickedColor, Countdown, Notes, Clipboard, Shell, Desktop, Nav } from "../data.slint";
import { Icon, IconButton, TextButton, Header, Row, Muted, Empty, ScrollList, Ring, Bar, RoundFace, NavScope } from "../common.slint";

// Scrolls through a list of choices a notch at a time, also with touchpads' small steps.
component NotchScroll inherits TouchArea {
    property <length> acc;
    callback forward();
    callback back();
    scroll-event(e) => {
        self.acc += e.delta-y + e.delta-x;
        if (self.acc <= -60px) {
            self.acc = 0;
            self.forward();
        } else if (self.acc >= 60px) {
            self.acc = 0;
            self.back();
        }
        accept
    }
}

export component KeyboardLayoutWidget inherits Rectangle {
    in property <bool> round;
    in property <bool> nav;
    property <LayoutItem> cur: KeyboardLayouts.layouts[KeyboardLayouts.current];
    // Room for the list of layouts.
    property <bool> list: !root.round && root.height > 150px && KeyboardLayouts.layouts.length > 1;
    if !root.list: Rectangle {
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: KeyboardLayouts.available ? root.cur.short : "–";
                horizontal-alignment: center;
                font-size: clamp(min(root.height * 0.38, root.width * 0.3), 18px, 72px);
                font-weight: Theme.font-weight-display;
                color: Theme.text;
            }
            if root.height > 70px && (!root.round || root.width > 150px): Text {
                text: KeyboardLayouts.available ? root.cur.name
                    : Desktop.niri ? "niri isn't reachable"
                    : Desktop.plasma ? "Plasma's keyboard layouts aren't reachable"
                    : "Keyboard layouts " + Desktop.unavailable;
                horizontal-alignment: center;
                font-size: Theme.font-small;
                color: Theme.dim;
                overflow: elide;
            }
        }
        NotchScroll {
            accessible-role: button;
            accessible-label: "Next keyboard layout";
            accessible-action-default => { KeyboardLayouts.next(); }
            clicked => { KeyboardLayouts.next(); }
            forward => { KeyboardLayouts.next(); }
            back => { KeyboardLayouts.prev(); }
        }
    }
    if root.list: VerticalLayout {
        padding: Theme.pad;
        spacing: 6px;
        Header {
            icon: Icons.keyboard;
            title: "Keyboard layout";
        }
        layout-list := ScrollList {
            for l[i] in KeyboardLayouts.layouts: Row {
                accessible-label: l.name;
                accessible-value: i == KeyboardLayouts.current ? "current" : "";
                selected: i == KeyboardLayouts.current;
                kfocus: keys.on && keys.cursor == i;
                revealed(y, h) => { layout-list.reveal(y, h); }
                clicked => { KeyboardLayouts.pick(i); }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 10px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 34px;
                        height: 22px;
                        border-radius: min(6px, Theme.radius-small);
                        background: i == KeyboardLayouts.current ? Theme.accent : Theme.card-raised;
                        Text {
                            text: l.short;
                            font-size: Theme.font-small;
                            font-weight: 600;
                            color: i == KeyboardLayouts.current ? Theme.on-accent : Theme.dim;
                        }
                    }
                    Text {
                        text: l.name;
                        vertical-alignment: center;
                        font-size: Theme.font-body;
                        color: Theme.text;
                        overflow: elide;
                    }
                }
            }
        }
    }
    // A list: j/k over the layouts, Enter picks. Otherwise h/l (or Enter) step through them.
    changed nav => {
        if (root.nav) {
            keys.move-to(KeyboardLayouts.current);
        }
    }
    keys := NavScope {
        accessible-label: "Keyboard layout";
        active: root.nav;
        count: root.list ? KeyboardLayouts.layouts.length : 0;
        activate(i) => {
            if (root.list) { KeyboardLayouts.pick(i); } else { KeyboardLayouts.next(); }
        }
        adjust(i, d) => {
            if (d > 0) { KeyboardLayouts.next(); } else { KeyboardLayouts.prev(); }
            true
        }
    }
}

// A color value that copies itself when clicked.
component CopyText inherits Rectangle {
    in property <string> text;
    in property <length> font: Theme.font-body;
    in property <color> tint: Theme.text;
    in property <bool> kfocus;
    accessible-role: button;
    accessible-label: "Copy " + root.text;
    accessible-item-selected: root.kfocus;
    accessible-action-default => { ColorPicker.copy(root.text); }
    height: 24px;
    border-radius: min(6px, Theme.radius-small);
    background: touch.pressed ? Theme.pressed : touch.has-hover || kfocus ? Theme.hover : transparent;
    animate background { duration: 100ms * Theme.motion; }
    border-width: kfocus ? 2px : 0px;
    border-color: Theme.accent;
    Text {
        x: 6px;
        width: parent.width - 12px;
        text: root.text;
        font-size: root.font;
        color: root.tint;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        clicked => { ColorPicker.copy(root.text); }
    }
}

export component ColorPickerWidget inherits Rectangle {
    in property <bool> round;
    in property <bool> nav;
    property <bool> has: ColorPicker.colors.length > 0;
    property <PickedColor> last: ColorPicker.colors[0];
    // Wide enough for rgb() and hsl() beside the swatch; tall enough for the history row.
    property <bool> details: !root.round && root.width >= 380px;
    property <bool> history: !root.round && root.height > 150px && ColorPicker.colors.length > 1;
    // Keyboard stops: the values to copy, the pipette, then the history swatches that fit.
    property <int> texts: root.round || !root.has ? 0 : root.details ? 3 : 1;
    property <int> swatches: root.history ? min(ColorPicker.colors.length - 1, floor((root.width - 2 * Theme.pad - 28px) / 34px) + 1) : 0;
    property <int> pipette: root.texts;
    if root.round: Rectangle {
        Rectangle {
            y: root.height * 0.42 - self.height / 2;
            width: root.width * 0.52;
            height: self.width;
            border-radius: self.width / 2;
            background: root.has ? root.last.color : Theme.card-raised;
            border-width: 2px;
            border-color: Theme.border;
            Icon {
                source: Icons.pipette;
                size: parent.width * 0.36;
                tint: root.has && root.last.color.to-hsv().value > 0.6 ? #000000b0 : #ffffffd0;
            }
        }
        Text {
            y: root.height * 0.8 - self.height / 2;
            text: root.has ? root.last.hex : "Pick";
            font-size: Theme.font-small;
            color: Theme.dim;
        }
        TouchArea {
            accessible-role: button;
            accessible-label: "Pick a color";
            accessible-action-default => { ColorPicker.pick(); }
            clicked => { ColorPicker.pick(); }
        }
    }
    if !root.round: VerticalLayout {
        padding: Theme.pad;
        spacing: 10px;
        alignment: center;
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: min(56px, root.height - 2 * Theme.pad);
                height: self.width;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-small;
                background: root.has ? root.last.color : Theme.card-raised;
                border-width: 1px;
                border-color: Theme.border;
            }
            VerticalLayout {
                alignment: center;
                spacing: 0px;
                horizontal-stretch: 1;
                if root.has: CopyText {
                    text: root.last.hex;
                    font: Theme.font-title;
                    kfocus: keys.on && keys.cursor == 0;
                }
                if !root.has: Muted {
                    text: "Click the pipette, then a pixel";
                }
                if root.details && root.has: CopyText {
                    text: root.last.rgb;
                    font: Theme.font-small;
                    tint: Theme.dim;
                    kfocus: keys.on && keys.cursor == 1;
                }
                if root.details && root.has: CopyText {
                    text: root.last.hsl;
                    font: Theme.font-small;
                    tint: Theme.dim;
                    kfocus: keys.on && keys.cursor == 2;
                }
            }
            IconButton {
                accessible-label: "Pick a color";
                y: (parent.height - self.height) / 2;
                icon: Icons.pipette;
                size: 36px;
                fill: Theme.card-raised;
                kfocus: keys.on && keys.cursor == root.pipette;
                clicked => { ColorPicker.pick(); }
            }
        }
        if root.history: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for c[i] in ColorPicker.colors: Rectangle {
                accessible-role: button;
                accessible-label: "Copy " + c.hex;
                accessible-item-selected: self.kfocus;
                accessible-action-default => { ColorPicker.copy(c.hex); }
                visible: i > 0 && (i - 1) * 34px + 28px <= root.width - 2 * Theme.pad;
                width: i > 0 ? 28px : 0px;
                height: 28px;
                border-radius: min(14px, Theme.radius-small);
                background: c.color;
                property <bool> kfocus: keys.on && keys.cursor == root.pipette + i;
                border-width: swatch.has-hover || self.kfocus ? 2px : 1px;
                border-color: self.kfocus ? Theme.accent : swatch.has-hover ? Theme.text : Theme.border;
                swatch := TouchArea {
                    clicked => { ColorPicker.copy(c.hex); }
                }
            }
        }
    }
    // j/k over the values, the pipette and the history; Enter copies (or picks); p picks.
    keys := NavScope {
        accessible-label: "Color picker";
        active: root.nav;
        count: root.round ? 0 : root.texts + 1 + root.swatches;
        activate(i) => {
            if (root.round || i == root.pipette) {
                ColorPicker.pick();
            } else if (i < root.pipette) {
                ColorPicker.copy(i == 0 ? root.last.hex : i == 1 ? root.last.rgb : root.last.hsl);
            } else {
                ColorPicker.copy(ColorPicker.colors[i - root.pipette].hex);
            }
        }
        letter(t) => {
            if (t == "p") {
                ColorPicker.pick();
                return true;
            }
            false
        }
    }
}

component TimerButtons inherits HorizontalLayout {
    in property <bool> stopwatch;
    in property <length> size: 36px;
    // The play / pause button (a round face's click does that instead).
    in property <bool> primary: true;
    // The keyboard cursor's button: 0 play / pause, 1 lap, 2 reset (-1: none).
    in property <int> kfocus: -1;
    spacing: 6px;
    alignment: center;
    if root.primary: IconButton {
        accessible-label: (root.stopwatch ? Countdown.sw-running : Countdown.running) ? "Pause" : "Start";
        kfocus: root.kfocus == 0;
        y: (parent.height - self.height) / 2;
        size: root.size;
        fill: Theme.accent-soft;
        tint: Theme.accent;
        icon: (root.stopwatch ? Countdown.sw-running : Countdown.running) ? Icons.pause : Icons.play;
        clicked => {
            if (root.stopwatch) { Countdown.sw-toggle(); } else { Countdown.toggle(); }
        }
    }
    if root.stopwatch && Countdown.sw-running: IconButton {
        accessible-label: "Lap";
        y: (parent.height - self.height) / 2;
        size: root.size;
        fill: Theme.card-raised;
        icon: Icons.flag;
        kfocus: root.kfocus == 1;
        clicked => { Countdown.sw-lap(); }
    }
    if (root.stopwatch && Countdown.sw-started && !Countdown.sw-running) || (!root.stopwatch && (Countdown.running || Countdown.paused || Countdown.done)): IconButton {
        accessible-label: "Reset";
        y: (parent.height - self.height) / 2;
        size: root.size;
        fill: Theme.card-raised;
        icon: Icons.reset;
        kfocus: root.kfocus == 2;
        clicked => {
            if (root.stopwatch) { Countdown.sw-reset(); } else { Countdown.reset(); }
        }
    }
}

// The timer and the stopwatch: big time, and the buttons; round, a ring around it.
component TimerBody inherits Rectangle {
    in property <bool> round;
    in property <bool> sw;
    in property <bool> nav;
    // Keyboard stops (rectangular): play / pause, lap and reset where shown, then the presets.
    property <bool> has-lap: root.sw && Countdown.sw-running;
    property <bool> has-reset: root.sw ? Countdown.sw-started && !Countdown.sw-running : Countdown.running || Countdown.paused || Countdown.done;
    property <int> presets: !root.sw && root.extras ? clamp(floor((root.width - 2 * Theme.pad - 72px) / 74px), 0, 4) : 0;
    property <int> buttons: 1 + (root.has-lap ? 1 : 0) + (root.has-reset ? 1 : 0);
    // What the cursor's stop is: 0 play / pause, 1 lap, 2 reset, 3 a preset.
    function stop(i: int) -> int {
        if (i == 0) { return 0; }
        if (i == 1 && root.has-lap) { return 1; }
        if (i < root.buttons) { return 2; }
        3
    }
    function toggle() {
        if (root.sw) { Countdown.sw-toggle(); } else { Countdown.toggle(); }
    }
    function reset() {
        if (root.sw) { Countdown.sw-reset(); } else { Countdown.reset(); }
    }
    property <string> shown: root.sw ? Countdown.sw-text : Countdown.done ? "Done" : Countdown.text;
    property <color> tint: !root.sw && Countdown.done ? Theme.warn : Theme.text;
    // Room for presets / lap buttons, and for the list of laps.
    property <bool> extras: root.height > 150px;
    property <bool> lap-list: root.sw && root.height > 260px && Countdown.laps.length > 0;
    // Square and centered, should the widget not be (a standalone app's window).
    if root.round: face := Rectangle {
        width: min(root.width, root.height);
        height: self.width;
        property <length> ring: max(5px, self.width * 0.06);
        // Buttons under the time once the face has room for them.
        property <bool> buttons: self.width >= 140px;
        if !root.sw: Ring {
            accessible-label: "Time left";
            width: 100%;
            height: 100%;
            value: Countdown.running || Countdown.paused ? Countdown.fraction : 0;
            thickness: face.ring;
            tint: Countdown.paused ? Theme.faint : Theme.accent;
        }
        if root.sw: Ring {
            accessible-label: "Current minute";
            width: 100%;
            height: 100%;
            value: Countdown.sw-started ? Countdown.sw-fraction : 0;
            thickness: face.ring;
            tint: Countdown.sw-running ? Theme.accent : Theme.faint;
        }
        // A stopwatch's dial: a mark every five seconds inside the ring, where there is room.
        if root.sw && face.buttons: Rectangle {
            property <length> r: face.width / 2 - face.ring * 2.2;
            property <length> dot: max(2px, face.width * 0.018);
            for i in 12: Rectangle {
                x: face.width / 2 + parent.r * sin(i * 30deg) - self.width / 2;
                y: face.width / 2 - parent.r * cos(i * 30deg) - self.height / 2;
                width: Math.mod(i, 3) == 0 ? parent.dot * 1.6 : parent.dot;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.faint;
            }
        }
        // Click starts and pauses, a double click resets (it also clicks twice, which a reset
        // makes moot); scrolling sets the countdown.
        TouchArea {
            accessible-role: button;
            accessible-label: (root.sw ? Countdown.sw-running : Countdown.running) ? "Pause" : "Start";
            accessible-action-default => { root.toggle(); }
            clicked => {
                if (root.sw) { Countdown.sw-toggle(); } else { Countdown.toggle(); }
            }
            double-clicked => {
                if (root.sw) { Countdown.sw-reset(); } else { Countdown.reset(); }
            }
            scroll-event(e) => {
                if (!root.sw) {
                    Countdown.adjust(e.delta-y > 0 ? -1 : 1);
                }
                accept
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            padding: face.ring * 2;
            Text {
                text: root.shown;
                horizontal-alignment: center;
                // As big as fits across the face.
                font-size: clamp(min(face.width * 0.21, face.width * 1.1 / max(4, root.shown.character-count)), 12px, 56px);
                font-weight: Theme.font-weight-display;
                color: root.tint;
            }
            Text {
                text: root.sw
                    ? (Countdown.sw-running ? "running" : Countdown.sw-started ? "paused" : "stopwatch")
                        + (Countdown.laps.length > 0 ? " · " + Countdown.laps.length + (Countdown.laps.length == 1 ? " lap" : " laps") : "")
                    : Countdown.running ? "running" : Countdown.paused ? "paused" : face.buttons ? "scroll to set" : "timer";
                horizontal-alignment: center;
                font-size: Theme.font-small;
                color: Theme.faint;
                overflow: elide;
            }
            if face.buttons: TimerButtons {
                height: 34px;
                stopwatch: root.sw;
                size: 30px;
                primary: false;
            }
        }
    }
    if !root.round: VerticalLayout {
        padding: Theme.pad;
        spacing: 10px;
        alignment: root.lap-list ? stretch : center;
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.shown;
                vertical-alignment: center;
                horizontal-stretch: 1;
                font-size: clamp(min(root.height * (root.extras ? 0.24 : 0.5), root.width * 0.16), 18px, 72px);
                font-weight: Theme.font-weight-display;
                color: root.tint;
                overflow: elide;
            }
            TimerButtons {
                stopwatch: root.sw;
                kfocus: keys.on && keys.cursor < root.buttons ? root.stop(keys.cursor) : -1;
            }
        }
        if !root.sw && (Countdown.running || Countdown.paused): Bar {
            accessible-label: "Time left";
            value: Countdown.fraction;
            tint: Countdown.paused ? Theme.faint : Theme.accent;
            thickness: 4px;
            high-is-bad: false;
        }
        if !root.sw && root.extras: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            IconButton {
                accessible-label: "Take a minute off";
                icon: Icons.minus;
                size: 30px;
                fill: Theme.card-raised;
                clicked => { Countdown.adjust(-1); }
            }
            // As many presets as fit between the − and + buttons.
            for m[i] in [1, 5, 10, 25]: TextButton {
                accessible-label: "Set timer to " + m + " min";
                visible: 72px + (i + 1) * 74px <= root.width - 2 * Theme.pad;
                width: self.visible ? self.min-width : 0px;
                text: m + " min";
                kfocus: keys.on && keys.cursor == root.buttons + i;
                clicked => { Countdown.preset(m); }
            }
            IconButton {
                accessible-label: "Add a minute";
                icon: Icons.plus;
                size: 30px;
                fill: Theme.card-raised;
                clicked => { Countdown.adjust(1); }
            }
        }
        if root.lap-list: ScrollList {
            vertical-stretch: 1;
            for l[i] in Countdown.laps: HorizontalLayout {
                height: 24px;
                Text {
                    text: "Lap " + (Countdown.laps.length - i);
                    color: Theme.dim;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: l;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
            }
        }
    }
    // Space starts and stops, r resets, h/l take a minute off or add one (timer). Rectangular:
    // j/k over the buttons and presets, Enter presses one.
    keys := NavScope {
        accessible-label: root.sw ? "Stopwatch" : "Timer";
        active: root.nav;
        count: root.round ? 0 : root.buttons + root.presets;
        activate(i) => {
            if (root.round) {
                root.toggle();
                return;
            }
            let s = root.stop(i);
            if (s == 0) {
                root.toggle();
            } else if (s == 1) {
                Countdown.sw-lap();
            } else if (s == 2) {
                root.reset();
            } else {
                Countdown.preset(i - root.buttons == 0 ? 1 : i - root.buttons == 1 ? 5 : i - root.buttons == 2 ? 10 : 25);
            }
        }
        adjust(i, d) => {
            if (root.sw) {
                return false;
            }
            Countdown.adjust(d);
            true
        }
        letter(t) => {
            if (t == " ") {
                root.toggle();
                return true;
            }
            if (t == "r") {
                root.reset();
                return true;
            }
            if (t == "a" && root.sw && Countdown.sw-running) {
                Countdown.sw-lap();
                return true;
            }
            false
        }
    }
}

export component TimerWidget inherits Rectangle {
    in property <bool> round;
    in property <bool> nav;
    TimerBody {
        round: root.round;
        sw: false;
        nav: root.nav;
    }
}

export component StopwatchWidget inherits Rectangle {
    in property <bool> round;
    in property <bool> nav;
    TimerBody {
        round: root.round;
        sw: true;
        nav: root.nav;
    }
}

// A note's text area in the theme's colors (std-widgets' TextEdit only has a light and a dark
// look). Scrolls to keep the cursor in view.
component NoteEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    // What the text area is for screen readers.
    in property <string> label;
    callback edited(string);
    property <length> line: input.font-size * 1.4;
    border-radius: Theme.radius-small;
    background: Theme.subtle;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    forward-focus: input;
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Cut";
                activated => { input.cut(); }
            }
            MenuItem {
                title: "Copy";
                enabled: root.text != "";
                activated => { input.copy(); }
            }
            MenuItem {
                title: "Paste";
                activated => { input.paste(); }
            }
            MenuItem {
                title: "Select All";
                enabled: root.text != "";
                activated => { input.select-all(); }
            }
        }
        flick := Flickable {
            x: Theme.pad-tight;
            y: Theme.pad-tight;
            width: parent.width - 2 * Theme.pad-tight;
            height: parent.height - 2 * Theme.pad-tight;
            content-height: max(self.height, input.preferred-height);
            input := TextInput {
                accessible-role: text-input;
                accessible-label: root.label;
                width: flick.width;
                single-line: false;
                wrap: word-wrap;
                font-size: Theme.font-body;
                color: Theme.text;
                selection-background-color: Theme.accent-soft;
                selection-foreground-color: Theme.text;
                page-height: flick.height;
                edited => { root.edited(self.text); }
                cursor-position-changed(cpos) => {
                    if (cpos.y + flick.content-y < 0px) {
                        flick.content-y = -cpos.y;
                    } else if (cpos.y + flick.content-y > flick.height - root.line) {
                        flick.content-y = min(0px, flick.height - cpos.y - root.line);
                    }
                }
            }
        }
    }
    Text {
        x: flick.x;
        y: flick.y;
        width: flick.width;
        text: root.text == "" && input.preedit-text == "" ? root.placeholder-text : "";
        font-size: input.font-size;
        color: Theme.faint;
        overflow: elide;
    }
}

export component NotesWidget inherits Rectangle {
    in property <int> id;
    // Entered with the keyboard: straight into the text. Escape leaves it again.
    in property <bool> nav;
    property <int> want: root.nav ? Nav.tick : -1;
    changed want => {
        if (root.nav) {
            edit.focus();
        }
    }
    init => {
        if (root.nav) {
            edit.focus();
        }
    }
    property <string> text: root.id < Notes.texts.length ? Notes.texts[root.id] : "";
    property <string> name: root.id < Notes.names.length ? Notes.names[root.id] : "Notes";
    VerticalLayout {
        padding: Theme.pad;
        padding-top: root.height > 150px ? Theme.pad : Theme.pad-tight;
        spacing: 6px;
        if root.height > 150px: Header {
            icon: Icons.note;
            title: root.name;
        }
        FocusScope {
            vertical-stretch: 1;
            key-pressed(e) => {
                // Escape closes the dashboard while typing (the note is saved already), unless the
                // note was entered with the keyboard: then it goes back to the dashboard, which
                // the key does on its way up.
                if (e.text == Key.Escape && !root.nav) {
                    Shell.hide();
                    return accept;
                }
                reject
            }
            edit := NoteEdit {
                label: root.name != "" ? root.name : "Notes";
                width: 100%;
                height: 100%;
                text: root.text;
                placeholder-text: "Write something…";
                edited(t) => { Notes.edited(root.id, t); }
            }
        }
    }
}

export component ClipboardWidget inherits Rectangle {
    in property <bool> round;
    in property <bool> nav;
    if root.round: RoundFace {
        icon: Icons.clipboard;
        tint: Clipboard.items.length > 0 ? Theme.accent : Theme.faint;
        caption: Clipboard.items.length + " items";
    }
    if !root.round: VerticalLayout {
        padding: Theme.pad;
        spacing: 6px;
        Header {
            icon: Icons.clipboard;
            title: "Clipboard";
            if Clipboard.items.length > 0: TextButton {
                accessible-label: "Clear clipboard history";
                text: "Clear";
                clicked => { Clipboard.clear(); }
            }
        }
        if !Clipboard.available: Empty {
            vertical-stretch: 1;
            text: "The compositor doesn't offer clipboard access";
        }
        if Clipboard.available && Clipboard.items.length == 0: Empty {
            vertical-stretch: 1;
            text: "Nothing copied yet";
        }
        if Clipboard.items.length > 0: clip-list := ScrollList {
            vertical-stretch: 1;
            for c[i] in Clipboard.items: Rectangle {
                height: c.is-image ? 72px : 44px;
                Row {
                    accessible-label: c.text;
                    accessible-value: c.index == 0 ? "current, " + c.info : c.info;
                    height: parent.height - 3px;
                    selected: c.index == 0;
                    kfocus: keys.on && keys.cursor == i && keys.sub == 0;
                    kfocus-part: keys.on && keys.cursor == i && keys.sub == 1;
                    revealed(y, h) => { clip-list.reveal(y, h); }
                    clicked => { Clipboard.copy(c.index); }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 4px;
                        spacing: 10px;
                        if c.is-image: Image {
                            y: 4px;
                            height: parent.height - 8px;
                            width: self.height * 1.5;
                            source: c.image;
                            image-fit: contain;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: c.text;
                                font-size: Theme.font-body;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Muted {
                                text: c.info;
                            }
                        }
                        IconButton {
                            accessible-label: "Remove from clipboard history";
                            y: (parent.height - self.height) / 2;
                            icon: Icons.close;
                            size: 26px;
                            tint: Theme.faint;
                            kfocus: keys.on && keys.cursor == i && keys.sub == 1;
                            clicked => { Clipboard.remove(c.index); }
                        }
                    }
                }
            }
        }
    }
    // j/k over the entries, Enter copies (l: the remove button), d removes, D clears all.
    keys := NavScope {
        accessible-label: "Clipboard";
        active: root.nav;
        count: root.round ? 0 : Clipboard.items.length;
        subs: 2;
        activate(i, sub) => {
            if (i < Clipboard.items.length) {
                if (sub == 1) { Clipboard.remove(Clipboard.items[i].index); } else { Clipboard.copy(Clipboard.items[i].index); }
            }
        }
        letter(t, i) => {
            if (t == "d" && i < Clipboard.items.length) {
                Clipboard.remove(Clipboard.items[i].index);
                return true;
            }
            if (t == "D") {
                Clipboard.clear();
                return true;
            }
            false
        }
    }
}
