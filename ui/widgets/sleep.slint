import { LineEdit } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Nav, NavMode } from "../data.slint";
import { Icon, IconButton, TextButton, Switch, Header, Row, Muted, Bar, Ring, NavScope } from "../common.slint";

export enum SleepStatus { idle, armed, paused, fired }

export struct SleepMode {
    label: string,
    help: string,
}

// The sleep timer: count down to sleep (or off), as `sleepy` does. The countdown is Rust's
// (crates/system/src/sleep.rs); this is what it shows and what can be pressed.
export global Sleep {
    // The modes this machine offers, and the one picked.
    in property <[SleepMode]> modes;
    in property <int> selected;
    // The when field: "30 min", "1h30m", "23:45".
    in-out property <string> when;
    // What the field promises ("→ in 30m"), or why it is no when yet.
    in property <string> echo;
    in property <string> problem;
    in property <SleepStatus> status;
    // "suspend in 29m 12s, at 23:45".
    in property <string> headline;
    // The time left as a clock, "29:12".
    in property <string> left;
    // The part still to go: 1 at the start, 0 at the end.
    in property <float> fraction;
    // What a finished countdown has to say ("dry run: would have run systemctl suspend").
    in property <string> outcome;
    in property <bool> dry-run;
    in property <bool> keep-awake;
    in property <bool> can-arm;
    callback edited(string);
    callback select(int);
    callback arm();
    callback pause-resume();
    callback abort();
    callback longer();
    callback shorter();
    callback toggle-dry-run();
    callback toggle-keep-awake();
}

// The when field. Under the keyboard cursor it is underlined, and a change of `edit-tick` then puts
// the keyboard in it.
component WhenField inherits VerticalLayout {
    in property <bool> kfocus;
    in property <int> edit-tick;
    callback accepted();
    spacing: 2px;
    height: 36px;
    changed edit-tick => {
        if (self.kfocus) {
            field.focus();
        }
    }
    field := LineEdit {
        height: 32px;
        // A LineEdit's accessible value is its text and can't be left out of the tree
        // selectively; the underline speaks for it.
        accessible-role: none;
        placeholder-text: "45s, 30 min, 1h30m, 23:45";
        text <=> Sleep.when;
        edited(t) => { Sleep.edited(t); }
        accepted => { root.accepted(); }
    }
    Rectangle {
        accessible-role: text-input;
        accessible-label: "When to sleep";
        accessible-value: Sleep.when;
        accessible-placeholder-text: "45s, 30 min, 1h30m, 23:45";
        accessible-item-selected: root.kfocus;
        accessible-action-default => { field.focus(); }
        height: 2px;
        border-radius: 1px;
        background: root.kfocus ? Theme.accent : transparent;
    }
}

component SleepBody inherits Rectangle {
    in property <bool> round;
    in property <bool> nav;
    property <bool> counting: Sleep.status == SleepStatus.armed || Sleep.status == SleepStatus.paused;
    property <int> modes: Sleep.modes.length;
    // Room for every mode as a row; otherwise one row that steps through them.
    property <bool> list: root.height > 400px && root.modes > 1;
    // Keyboard stops (rectangular): the field, the modes (one stop for all of them when not
    // listed), the two switches (parts of one stop), the buttons (parts of one stop).
    property <int> mode-stops: root.round ? 0 : root.list ? root.modes : 1;
    property <int> k-toggles: 1 + root.mode-stops;
    property <int> k-actions: root.k-toggles + 1;
    property <int> edit-tick;
    property <string> mode-name: Sleep.selected >= 0 && Sleep.selected < root.modes ? Sleep.modes[Sleep.selected].label : "none offered";
    function kf(stop: int, part: int) -> bool {
        keys.on && keys.cursor == stop && keys.sub == part
    }
    // Arm, or pause and resume.
    function primary() {
        if (root.counting) {
            Sleep.pause-resume();
        } else {
            Sleep.arm();
        }
    }
    // Enter in the field arms, as in sleepy, and the keys are the dashboard's again.
    function typed() {
        Sleep.arm();
        keys.focus();
    }
    property <color> tint: Sleep.status == SleepStatus.fired ? Theme.warn : Theme.text;

    // Ctrl+D flips the dry run wherever the keyboard is in the widget, a text field included.
    // Up and down move over the stops, h and l step the mode or move between a stop's parts,
    // Enter presses, Space pauses, + and - move the deadline, d dry run, a keeps the screen on,
    // i types in the field; Escape gives up on the countdown before it leaves the widget.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(e) => {
            if (e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && (e.text == "d" || e.text == "D")) {
                Sleep.toggle-dry-run();
                return accept;
            }
            reject
        }
        keys := NavScope {
            accessible-label: "Sleep timer";
            active: root.nav;
            count: root.round ? 0 : root.k-actions + 1;
            subs: keys.cursor == root.k-toggles ? 2 : keys.cursor == root.k-actions ? 4 : 1;
            // The mode highlight follows the cursor down the list.
            changed cursor => {
                if (root.list && self.cursor >= 1 && self.cursor <= root.modes && Sleep.selected != self.cursor - 1) {
                    Sleep.select(self.cursor - 1);
                }
            }
            activate(i, sub) => {
                if (root.round) {
                    root.primary();
                } else if (i == 0) {
                    root.edit-tick += 1;
                } else if (i == root.k-toggles) {
                    if (sub == 0) { Sleep.toggle-dry-run(); } else { Sleep.toggle-keep-awake(); }
                } else if (i == root.k-actions) {
                    if (sub == 0) { root.primary(); }
                    else if (sub == 1) { Sleep.abort(); }
                    else if (sub == 2) { Sleep.shorter(); }
                    else { Sleep.longer(); }
                } else {
                    // On a mode: arm with it.
                    Sleep.arm();
                }
            }
            adjust(i, d) => {
                if (!root.round && !root.list && i == 1 && root.modes > 0) {
                    Sleep.select(Math.mod(Sleep.selected + d + root.modes, root.modes));
                    return true;
                }
                if (root.round && root.counting) {
                    if (d < 0) { Sleep.shorter(); } else { Sleep.longer(); }
                    return true;
                }
                false
            }
            letter(t, i) => {
                if (t == " " && root.counting) {
                    Sleep.pause-resume();
                    return true;
                }
                if (t == "p") {
                    Sleep.pause-resume();
                    return true;
                }
                if (t == "+" || t == "=") {
                    Sleep.longer();
                    return true;
                }
                if (t == "-" || t == "_") {
                    Sleep.shorter();
                    return true;
                }
                if (t == "d") {
                    Sleep.toggle-dry-run();
                    return true;
                }
                if (t == "a") {
                    Sleep.toggle-keep-awake();
                    return true;
                }
                if (t == "i" && !root.round && i == 0) {
                    root.edit-tick += 1;
                    return true;
                }
                false
            }
            back => {
                if (root.counting || Sleep.status == SleepStatus.fired) {
                    Sleep.abort();
                    return true;
                }
                false
            }

            if root.round: face := Rectangle {
                width: min(root.width, root.height);
                height: self.width;
                property <length> ring: max(5px, self.width * 0.06);
                property <bool> roomy: self.width >= 140px;
                property <string> shown: root.counting ? Sleep.left : Sleep.status == SleepStatus.fired ? "Now" : Sleep.when;
                Ring {
                    accessible-label: "Time left";
                    width: 100%;
                    height: 100%;
                    value: root.counting ? Sleep.fraction : 0;
                    thickness: face.ring;
                    tint: Sleep.status == SleepStatus.paused ? Theme.faint : Theme.accent;
                }
                // Click arms, pauses and resumes; a double click gives up; scrolling moves the deadline.
                TouchArea {
                    accessible-role: button;
                    accessible-label: root.counting ? (Sleep.status == SleepStatus.paused ? "Resume" : "Pause") : "Arm";
                    accessible-action-default => { root.primary(); }
                    clicked => { root.primary(); }
                    double-clicked => { Sleep.abort(); }
                    scroll-event(e) => {
                        if (root.counting) {
                            if (e.delta-y > 0) { Sleep.longer(); } else { Sleep.shorter(); }
                        }
                        accept
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    padding: face.ring * 2;
                    Icon {
                        visible: face.roomy;
                        height: face.roomy ? 22px : 0px;
                        source: Icons.moon;
                        size: 20px;
                        tint: root.counting ? Theme.accent : Theme.dim;
                    }
                    Text {
                        text: face.shown;
                        horizontal-alignment: center;
                        font-size: clamp(min(face.width * 0.2, face.width * 1.1 / max(4, face.shown.character-count)), 12px, 52px);
                        font-weight: Theme.font-weight-display;
                        color: root.tint;
                        overflow: elide;
                    }
                    Text {
                        text: root.counting ? (Sleep.status == SleepStatus.paused ? "paused" : root.mode-name) : Sleep.status == SleepStatus.fired ? "time!" : root.mode-name;
                        horizontal-alignment: center;
                        font-size: Theme.font-small;
                        color: Theme.faint;
                        overflow: elide;
                    }
                }
            }

            if !root.round: VerticalLayout {
                padding: Theme.pad;
                spacing: 8px;
                if root.height > 250px: Header {
                    icon: Icons.moon;
                    title: "Sleep timer";
                    Text {
                        text: root.counting ? Sleep.left : "";
                        color: Sleep.status == SleepStatus.paused ? Theme.faint : Theme.accent;
                        font-size: Theme.font-title;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    height: 58px;
                    WhenField {
                        kfocus: root.kf(0, 0);
                        edit-tick: root.edit-tick;
                        accepted => { root.typed(); }
                    }
                    Text {
                        text: Sleep.problem != "" ? Sleep.problem : Sleep.echo;
                        color: Sleep.problem != "" ? Theme.bad : Theme.dim;
                        font-size: Theme.font-small;
                        overflow: elide;
                    }
                }
                if !root.list: Row {
                    height: 30px;
                    accessible-label: "Mode";
                    accessible-value: root.mode-name;
                    accessible-action-default => { Sleep.select(Math.mod(Sleep.selected + 1, max(1, root.modes))); }
                    kfocus: root.kf(1, 0);
                    background: self.kfocus || self.hovered ? Theme.hover : Theme.card-raised;
                    clicked => { Sleep.select(Math.mod(Sleep.selected + 1, max(1, root.modes))); }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            source: Icons.chevron-left;
                            size: 14px;
                            tint: Theme.dim;
                        }
                        Text {
                            text: root.mode-name;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-size: Theme.font-body;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Icon {
                            y: (parent.height - self.height) / 2;
                            source: Icons.chevron-right;
                            size: 14px;
                            tint: Theme.dim;
                        }
                    }
                }
                if root.list: VerticalLayout {
                    spacing: 2px;
                    for m[i] in Sleep.modes: Row {
                        height: 28px;
                        selected: i == Sleep.selected;
                        accessible-label: m.label;
                        accessible-value: i == Sleep.selected ? "selected" : "";
                        accessible-description: m.help;
                        kfocus: root.kf(1 + i, 0);
                        clicked => { Sleep.select(i); }
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: (i == Sleep.selected ? "› " : "   ") + m.label;
                            vertical-alignment: center;
                            font-size: Theme.font-body;
                            font-weight: i == Sleep.selected ? 600 : 400;
                            color: Theme.text;
                            overflow: elide;
                        }
                    }
                    Muted {
                        text: Sleep.selected >= 0 && Sleep.selected < root.modes ? Sleep.modes[Sleep.selected].help : "";
                        height: 20px;
                    }
                }
                HorizontalLayout {
                    height: 24px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "Dry run";
                            color: Sleep.dry-run ? Theme.text : Theme.dim;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        Switch {
                            accessible-label: "Dry run";
                            y: (parent.height - self.height) / 2;
                            checked: Sleep.dry-run;
                            kfocus: root.kf(root.k-toggles, 0);
                            toggled => { Sleep.toggle-dry-run(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "Keep screen on";
                            color: Sleep.keep-awake ? Theme.text : Theme.dim;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Switch {
                            accessible-label: "Keep screen on";
                            y: (parent.height - self.height) / 2;
                            checked: Sleep.keep-awake;
                            kfocus: root.kf(root.k-toggles, 1);
                            toggled => { Sleep.toggle-keep-awake(); }
                        }
                    }
                }
                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    TextButton {
                        text: Sleep.status == SleepStatus.armed ? "Pause" : Sleep.status == SleepStatus.paused ? "Resume" : "Arm";
                        primary: true;
                        enabled: root.counting || Sleep.can-arm;
                        kfocus: root.kf(root.k-actions, 0);
                        clicked => { root.primary(); }
                    }
                    TextButton {
                        text: "Abort";
                        enabled: root.counting || Sleep.status == SleepStatus.fired;
                        kfocus: root.kf(root.k-actions, 1);
                        clicked => { Sleep.abort(); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        accessible-label: "Take a minute off";
                        icon: Icons.minus;
                        size: 30px;
                        fill: Theme.card-raised;
                        enabled: root.counting;
                        kfocus: root.kf(root.k-actions, 2);
                        clicked => { Sleep.shorter(); }
                    }
                    IconButton {
                        accessible-label: "Add a minute";
                        icon: Icons.plus;
                        size: 30px;
                        fill: Theme.card-raised;
                        enabled: root.counting;
                        kfocus: root.kf(root.k-actions, 3);
                        clicked => { Sleep.longer(); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        accessible-role: none;
                        text: Sleep.headline;
                        color: root.tint;
                        font-size: Theme.font-body;
                        font-weight: root.counting ? 600 : 400;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                    if root.counting: Bar {
                        accessible-label: "Time left";
                        value: Sleep.fraction;
                        tint: Sleep.status == SleepStatus.paused ? Theme.faint : Theme.accent;
                        thickness: 4px;
                        high-is-bad: false;
                    }
                    if Sleep.outcome != "": Text {
                        text: Sleep.outcome;
                        color: Theme.dim;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

export component SleepTimerWidget inherits Rectangle {
    in property <bool> round;
    in property <bool> nav;
    SleepBody {
        round: root.round;
        nav: root.nav;
    }
}
