# The system tests' environment: an Arch image (the same glibc as the development machine, so a
# test binary built there runs in it) with mocks of the services niri-dash talks to, on buses of
# their own. `run.sh` builds it and mounts the test binary in.
FROM docker.io/library/archlinux:latest

RUN pacman -Sy --noconfirm --needed dbus python-dbusmock python-dbus python-gobject \
    && pacman -Scc --noconfirm

COPY mocks.py /usr/local/bin/mocks.py
RUN chmod +x /usr/local/bin/mocks.py

ENV NIRI_DASH_SYSTEM_TESTS=1
ENTRYPOINT ["/usr/local/bin/mocks.py"]
